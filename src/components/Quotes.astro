---
import { QUOTES } from './constants';

const index = Math.floor(Math.random() * QUOTES.length);
const quote = QUOTES[index];
---

<script>
  import { initQuoteRotator } from '../scripts/quote-rotator';

  const block = document.getElementById('quote-block');
  if (block) {
    const quotes = JSON.parse(block.dataset.quotes || '[]');
    const index = parseInt(block.dataset.index || '0');
    initQuoteRotator(quotes, index);
  }
</script>

<blockquote
  id="quote-block"
  class="relative bg-gradient-to-br from-[#0f3460]/90 to-[#1a1a2e]/90 border-2 border-[#e94560] shadow-xl p-8 my-8 max-w-2xl mx-auto text-lg text-[#fef5e7] transition-all duration-500 ease-in-out"
  style="border-radius: 24px 8px 24px 8px; font-family: 'Outfit', sans-serif;"
  data-quotes={JSON.stringify(QUOTES)}
  data-initial-index={index}
>
  <!-- Retro corner accents -->
  <div
    class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-[#f8b500]"
    style="border-radius: 8px 0 0 0;"
  >
  </div>
  <div
    class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-[#0f9b8e]"
    style="border-radius: 0 0 8px 0;"
  >
  </div>

  <!-- Quote mark -->
  <span
    class="absolute -top-3 -right-3 text-[#f8b500] text-2xl"
    style="text-shadow: 0 0 10px #f8b500;">"</span
  >

  <div id="quote-content" class="transition-all duration-500 ease-in-out">
    <span id="quote-text" class="block mb-4 text-[#fef5e7] italic leading-relaxed"
      >{quote.quote}</span
    >
    <cite
      id="quote-author"
      class="block text-right text-sm text-[#0f9b8e] font-semibold mt-3 not-italic tracking-wider uppercase"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      — {quote.author}
    </cite>
  </div>

  <!-- Decorative bottom swoosh -->
  <div
    class="absolute bottom-2 left-1/2 -translate-x-1/2 w-16 h-0.5 bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e] rounded-full opacity-60"
  >
  </div>
</blockquote>

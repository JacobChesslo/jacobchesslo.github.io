---
import { QUOTES } from './constants';

const index = Math.floor(Math.random() * QUOTES.length);
const quote = QUOTES[index];
---

<section class="quote-section" aria-label="Quote">
  <blockquote id="quote-block" data-quotes={JSON.stringify(QUOTES)} data-initial-index={index}>
    <div class="quote-mark" aria-hidden="true">"</div>
    <div id="quote-content" class="quote-content">
      <p id="quote-text" class="quote-text">{quote.quote}</p>
      <cite id="quote-author" class="quote-author">- {quote.author}</cite>
    </div>
  </blockquote>
</section>

<script>
  import { initQuoteRotator, lockQuoteHeight } from '../scripts/quote-rotator';

  const block = document.getElementById('quote-block');
  if (block) {
    const quotes = JSON.parse(block.dataset.quotes || '[]');
    const index = parseInt(block.dataset.initialIndex || '0');
    lockQuoteHeight(quotes);
    initQuoteRotator(quotes, index);
  }
</script>

<style>
  .quote-section {
    padding: var(--space-xl) var(--space-lg);
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  blockquote {
    position: relative;
    margin: 0;
  }

  .quote-mark {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-a25);
    margin-bottom: -1.5rem;
    user-select: none;
  }

  .quote-content {
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #quote-text {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-dim);
    line-height: 1.75;
    margin-bottom: 20px;
  }

  .quote-author {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tertiary);
    font-style: normal;
  }
</style>

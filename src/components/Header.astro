---
import { NAVIGATIONS } from './constants'
---

<header class="bg-gray-900 text-white px-6 py-4 shadow-md">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    <h1 class="text-2xl font-bold tracking-tight">Jacob Chesslo</h1>
    <nav class="flex gap-4 mt-2 sm:mt-0">
      {
        NAVIGATIONS.map(item => (
          <a
            title={item.label}
            href={item.href}
            class="text-gray-300 hover:text-white transition-colors duration-150 font-medium px-2 py-1 rounded hover:bg-gray-800"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <!-- Theme Dropdown -->
    <div class="relative ml-4">
      <label for="theme-select" class="sr-only">Theme</label>
      <select
        id="theme-select"
        class="theme-dropdown px-8 py-1 rounded-full bg-gradient-to-r from-indigo-900/80 via-blue-900/80 to-purple-900/80 text-accent border-2 border-accent shadow-lg focus:outline-none focus:ring-2 focus:ring-accent transition-all duration-200 appearance-none cursor-pointer font-semibold"
        aria-label="Select theme"
        style="box-shadow: 0 0 8px 2px var(--color-accent, #38bdf8), 0 2px 8px #0006; background-blend-mode: lighten; min-width: 120px;"
      >
        <option value="system">💻</option>
        <option value="light">🌝</option>
        <option value="dark">🌚</option>
      </select>
      <!-- Custom dropdown arrow with cosmic accent -->
      <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-accent text-lg drop-shadow-glow" aria-hidden="true" style="text-shadow: 0 0 6px var(--color-accent, #38bdf8);">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <style>
        .text-accent {
          color: var(--color-accent, #38bdf8);
        }
        .border-accent {
          border-color: var(--color-accent, #38bdf8);
        }
        .drop-shadow-glow {
          filter: drop-shadow(0 0 6px var(--color-accent, #38bdf8));
        }
        .theme-dropdown:focus {
          outline: 2px solid var(--color-accent, #38bdf8);
          outline-offset: 2px;
        }
      </style>
    </div>
  </div>
  <script is:inline>
    // Theme dropdown logic
    const select = document.getElementById('theme-select');
    const body = document.body;
    const THEME_KEY = 'theme-preference';

    // Apply theme based on preference
    function applyTheme(theme) {
      body.classList.remove('theme-light', 'theme-dark');
      if (theme === 'light') {
        body.classList.add('theme-light');
      } else if (theme === 'dark') {
        body.classList.add('theme-dark');
      }
      // If 'system', no class is added, so CSS uses prefers-color-scheme
    }

    // Get system preference
    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    // Set dropdown to match current theme
    function setDropdown(theme) {
      if (theme === 'light' || theme === 'dark') {
        select.value = theme;
      } else {
        select.value = 'system';
      }
    }

    // On load: use saved preference or system
    function initTheme() {
      let theme = localStorage.getItem(THEME_KEY);
      if (!theme || theme === 'system') {
        // Use system preference
        theme = 'system';
        applyTheme(getSystemTheme());
      } else {
        applyTheme(theme);
      }
      setDropdown(theme);
    }

    // Listen for system changes if "system" is selected
    let systemListener;
    function watchSystemTheme() {
      if (systemListener) {
        window.matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', systemListener);
      }
      if (select.value === 'system') {
        systemListener = (e) => {
          applyTheme(e.matches ? 'dark' : 'light');
        };
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', systemListener);
      }
    }

    select?.addEventListener('change', () => {
      const value = select.value;
      localStorage.setItem(THEME_KEY, value);
      if (value === 'system') {
        applyTheme(getSystemTheme());
        watchSystemTheme();
      } else {
        applyTheme(value);
        if (systemListener) {
          window.matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', systemListener);
        }
      }
    });

    // Initialize on page load
    initTheme();
    watchSystemTheme();
  </script>
</header>

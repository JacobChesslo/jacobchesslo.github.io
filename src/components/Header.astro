---
import { NAVIGATIONS } from './constants'
---

<header class="relative z-20 bg-gradient-to-r from-[#1a1a2e] via-[#16213e] to-[#1a1a2e] border-b-2 border-[#e94560] px-6 py-4 shadow-lg">
  <!-- Retro accent line -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e]"></div>

  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    <h1 class="text-2xl font-bold tracking-widest uppercase text-[#fef5e7]" style="font-family: 'Space Grotesk', sans-serif; text-shadow: 2px 2px 0 #e94560;">
      Jacob Chesslo
    </h1>
    <nav class="flex gap-1 mt-2 sm:mt-0">
      {
        NAVIGATIONS.map(item => (
          <a
            title={item.label}
            href={item.href}
            class="text-[#fef5e7] hover:text-[#f8b500] transition-all duration-200 font-medium px-3 py-1 rounded-full hover:bg-[#e94560]/20 uppercase text-sm tracking-wider"
            style="font-family: 'Space Grotesk', sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <!-- Theme Dropdown - Retro Style -->
    <div class="relative ml-4">
      <label for="theme-select" class="sr-only">Theme</label>
      <select
        id="theme-select"
        class="theme-dropdown px-6 py-1.5 rounded-full bg-[#0f3460] text-[#f8b500] border-2 border-[#f8b500] shadow-lg focus:outline-none focus:ring-2 focus:ring-[#e94560] transition-all duration-200 appearance-none cursor-pointer font-semibold uppercase text-sm tracking-wider"
        aria-label="Select theme"
        style="font-family: 'Space Grotesk', sans-serif; box-shadow: 0 4px 0 #1a1a2e, 0 0 12px #f8b50033; min-width: 100px;"
      >
        <option value="system">Auto</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
      <!-- Retro dropdown arrow -->
      <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[#f8b500]" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
          <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <style>
        .theme-dropdown:focus {
          outline: 2px solid #e94560;
          outline-offset: 2px;
        }
        .theme-dropdown:hover {
          background: #16213e;
          transform: translateY(-1px);
          box-shadow: 0 5px 0 #1a1a2e, 0 0 16px #f8b50044;
        }
        .theme-dropdown option {
          background: #1a1a2e;
          color: #fef5e7;
        }
      </style>
    </div>
  </div>
  <script is:inline>
    // Theme dropdown logic
    const select = document.getElementById('theme-select');
    const body = document.body;
    const THEME_KEY = 'theme-preference';

    // Apply theme based on preference
    function applyTheme(theme) {
      body.classList.remove('theme-light', 'theme-dark');
      if (theme === 'light') {
        body.classList.add('theme-light');
      } else if (theme === 'dark') {
        body.classList.add('theme-dark');
      }
      // If 'system', no class is added, so CSS uses prefers-color-scheme
    }

    // Get system preference
    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    // Set dropdown to match current theme
    function setDropdown(theme) {
      if (theme === 'light' || theme === 'dark') {
        select.value = theme;
      } else {
        select.value = 'system';
      }
    }

    // On load: use saved preference or system
    function initTheme() {
      let theme = localStorage.getItem(THEME_KEY);
      if (!theme || theme === 'system') {
        // Use system preference
        theme = 'system';
        applyTheme(getSystemTheme());
      } else {
        applyTheme(theme);
      }
      setDropdown(theme);
    }

    // Listen for system changes if "system" is selected
    let systemListener;
    function watchSystemTheme() {
      if (systemListener) {
        window.matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', systemListener);
      }
      if (select.value === 'system') {
        systemListener = (e) => {
          applyTheme(e.matches ? 'dark' : 'light');
        };
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', systemListener);
      }
    }

    select?.addEventListener('change', () => {
      const value = select.value;
      localStorage.setItem(THEME_KEY, value);
      if (value === 'system') {
        applyTheme(getSystemTheme());
        watchSystemTheme();
      } else {
        applyTheme(value);
        if (systemListener) {
          window.matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', systemListener);
        }
      }
    });

    // Initialize on page load
    initTheme();
    watchSystemTheme();
  </script>
</header>

---
import { NAVIGATIONS } from './constants';
---

<header
  class="relative z-20 bg-gradient-to-r from-[#1a1a2e] via-[#16213e] to-[#1a1a2e] border-b-2 border-[#e94560] px-4 sm:px-6 py-4 shadow-lg"
>
  <!-- Retro accent line -->
  <div
    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e]"
  >
  </div>

  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
    <!-- Logo -->
    <a
      href="/"
      class="text-xl sm:text-2xl font-bold tracking-widest uppercase !text-[#fef5e7] hover:!text-[#f8b500] transition-colors"
      style="font-family: 'Space Grotesk', sans-serif; text-shadow: 3px 3px 0 #e94560, 6px 6px 0 rgba(0,0,0,0.2);"
    >
      Jacob Chesslo
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {
        NAVIGATIONS.map((item) => (
          <a
            title={item.label}
            href={item.href}
            class="text-[#fef5e7] hover:text-[#f8b500] transition-all duration-200 font-medium px-3 py-1 rounded-full hover:bg-[#e94560]/20 uppercase text-sm tracking-wider"
            style="font-family: 'Space Grotesk', sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
      <!-- Theme Dropdown - Desktop -->
      <div class="relative ml-2">
        <label for="theme-select" class="sr-only">Theme</label>
        <select
          id="theme-select"
          class="theme-dropdown px-4 py-1.5 rounded-full bg-[#0f3460] text-[#f8b500] border-2 border-[#f8b500] shadow-lg focus:outline-none focus:ring-2 focus:ring-[#e94560] transition-all duration-200 appearance-none cursor-pointer font-semibold uppercase text-xs tracking-wider"
          aria-label="Select theme"
          style="font-family: 'Space Grotesk', sans-serif; box-shadow: 0 4px 0 #1a1a2e, 0 0 12px #f8b50033; min-width: 80px;"
        >
          <option value="system">Auto</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
        <span
          class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[#f8b500]"
          aria-hidden="true"
        >
          <svg width="12" height="12" viewBox="0 0 20 20" fill="none">
            <path
              d="M6 8l4 4 4-4"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-[#fef5e7] hover:text-[#f8b500] transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="close-icon"
        class="w-6 h-6 hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-menu" class="hidden md:hidden mt-4 pb-2 border-t border-[#e94560]/30 pt-4">
    <div class="flex flex-col gap-2">
      {
        NAVIGATIONS.map((item) => (
          <a
            title={item.label}
            href={item.href}
            class="text-[#fef5e7] hover:text-[#f8b500] transition-all duration-200 font-medium px-3 py-2 rounded-lg hover:bg-[#e94560]/20 uppercase text-sm tracking-wider text-center"
            style="font-family: 'Space Grotesk', sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
      <!-- Theme Dropdown - Mobile -->
      <div class="relative mt-2 mx-auto">
        <label for="theme-select-mobile" class="sr-only">Theme</label>
        <select
          id="theme-select-mobile"
          class="theme-dropdown-mobile px-6 py-2 rounded-full bg-[#0f3460] text-[#f8b500] border-2 border-[#f8b500] shadow-lg focus:outline-none focus:ring-2 focus:ring-[#e94560] transition-all duration-200 appearance-none cursor-pointer font-semibold uppercase text-sm tracking-wider"
          aria-label="Select theme"
          style="font-family: 'Space Grotesk', sans-serif; box-shadow: 0 4px 0 #1a1a2e; min-width: 120px;"
        >
          <option value="system">Auto</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
        <span
          class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[#f8b500]"
          aria-hidden="true"
        >
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
            <path
              d="M6 8l4 4 4-4"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </div>
  </nav>

  <style>
    .theme-dropdown:focus,
    .theme-dropdown-mobile:focus {
      outline: 2px solid #e94560;
      outline-offset: 2px;
    }
    .theme-dropdown:hover {
      background: #16213e;
      transform: translateY(-1px);
      box-shadow:
        0 5px 0 #1a1a2e,
        0 0 16px #f8b50044;
    }
    .theme-dropdown option,
    .theme-dropdown-mobile option {
      background: #1a1a2e;
      color: #fef5e7;
    }
  </style>

  <script is:inline>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    menuBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
      menuBtn.setAttribute('aria-expanded', !isOpen);
    });

    // Theme dropdown logic
    const selectDesktop = document.getElementById('theme-select');
    const selectMobile = document.getElementById('theme-select-mobile');
    const body = document.body;
    const THEME_KEY = 'theme-preference';

    function applyTheme(theme) {
      body.classList.remove('theme-light', 'theme-dark');
      if (theme === 'light') {
        body.classList.add('theme-light');
      } else if (theme === 'dark') {
        body.classList.add('theme-dark');
      }
    }

    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function setDropdowns(theme) {
      const value = theme === 'light' || theme === 'dark' ? theme : 'system';
      if (selectDesktop) selectDesktop.value = value;
      if (selectMobile) selectMobile.value = value;
    }

    function initTheme() {
      let theme = localStorage.getItem(THEME_KEY);
      if (!theme || theme === 'system') {
        theme = 'system';
        applyTheme(getSystemTheme());
      } else {
        applyTheme(theme);
      }
      setDropdowns(theme);
    }

    let systemListener;
    function watchSystemTheme() {
      if (systemListener) {
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .removeEventListener('change', systemListener);
      }
      const currentTheme = localStorage.getItem(THEME_KEY);
      if (!currentTheme || currentTheme === 'system') {
        systemListener = (e) => {
          applyTheme(e.matches ? 'dark' : 'light');
        };
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', systemListener);
      }
    }

    function handleThemeChange(value) {
      localStorage.setItem(THEME_KEY, value);
      setDropdowns(value);
      if (value === 'system') {
        applyTheme(getSystemTheme());
        watchSystemTheme();
      } else {
        applyTheme(value);
        if (systemListener) {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .removeEventListener('change', systemListener);
        }
      }
    }

    selectDesktop?.addEventListener('change', (e) => handleThemeChange(e.target.value));
    selectMobile?.addEventListener('change', (e) => handleThemeChange(e.target.value));

    initTheme();
    watchSystemTheme();
  </script>
</header>

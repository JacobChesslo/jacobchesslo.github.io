---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  ogImage?: string;
}

const {
  title = 'Jacob Chesslo',
  description = 'Personal website of Jacob Chesslo - software engineer, physicist, and space enthusiast.',
  fullWidth = false,
  ogImage = '/og/default.png',
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.url).href;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <!-- Dark canvas from first paint (no white flash) + dark UA scrollbars/controls -->
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- iOS home-screen install: match the manifest's standalone display, dark status bar -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Jacob Chesslo" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jacob Chesslo" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <!-- Self-hosted fonts (@font-face in fonts.css) - preload the two on the critical path -->
    <link
      rel="preload"
      href="/fonts/syne-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/outfit-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body style="display: flex; flex-direction: column; min-height: 100vh;">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Header />
    <main
      id="main-content"
      tabindex="-1"
      style={fullWidth
        ? 'flex: 1; width: 100%;'
        : 'flex: 1; width: 100%; max-width: 80rem; margin: 0 auto; padding: 2rem 1rem;'}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

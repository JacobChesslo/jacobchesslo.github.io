<script>
  import { animate, inView, stagger } from 'motion';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    // ── Timeline line draw ──────────────────────────────────────
    const timelineLine = document.querySelector<HTMLElement>('.timeline-line');
    if (timelineLine) {
      inView(
        '#experience',
        () => {
          animate(timelineLine, { scaleY: [0, 1] }, { duration: 1.4, ease: [0.16, 1, 0.3, 1] });
        },
        { margin: '0px 0px -100px 0px' }
      );
    }

    // ── Exp items: entrance (once per element) ─────────────────
    // motion v12 inView has no `once` option — track manually
    const enteredItems = new Set<Element>();

    inView('.exp-item', (entry) => {
      const item = entry.target as HTMLElement;
      if (enteredItems.has(item)) return;
      enteredItems.add(item);

      const dot = item.querySelector<HTMLElement>('.exp-dot');
      const highlights = Array.from(item.querySelectorAll<HTMLElement>('.exp-highlight'));

      animate(item, { x: [-30, 0], opacity: [0, 1] }, { duration: 0.7, ease: [0.16, 1, 0.3, 1] });

      if (dot) {
        animate(
          dot,
          { scale: [0, 1.3, 1], opacity: [0, 1] },
          { duration: 0.5, ease: [0.34, 1.56, 0.64, 1] }
        );
      }

      if (highlights.length) {
        animate(
          highlights,
          { x: [-16, 0], opacity: [0, 1] },
          {
            delay: stagger(0.06, { start: 0.4 }),
            duration: 0.45,
            ease: [0.16, 1, 0.3, 1],
          }
        );
      }
    });

    // ── Exp dot ring: radar pulse while item is in view ─────────
    inView(
      '.exp-item',
      (entry) => {
        const ring = (entry.target as HTMLElement).querySelector<HTMLElement>('.exp-dot-ring');
        if (!ring) return;

        const pulse = () =>
          animate(
            ring,
            { scale: [1, 3.5], opacity: [0.7, 0] },
            {
              duration: 1.4,
              ease: [0.16, 1, 0.3, 1],
            }
          );

        const initial = setTimeout(pulse, 800);
        const id = setInterval(pulse, 3200);

        return () => {
          clearTimeout(initial);
          clearInterval(id);
        };
      },
      { amount: 0.3 }
    );

    // ── Education cards (once) ──────────────────────────────────
    const seenEdu = new Set<Element>();
    inView('.edu-card', (entry) => {
      if (seenEdu.has(entry.target)) return;
      seenEdu.add(entry.target);
      animate(
        entry.target as HTMLElement,
        { y: [24, 0], opacity: [0, 1] },
        {
          duration: 0.6,
          ease: [0.16, 1, 0.3, 1],
        }
      );
    });

    // ── Project cards (once) ────────────────────────────────────
    const seenProj = new Set<Element>();
    inView('.proj-card', (entry) => {
      if (seenProj.has(entry.target)) return;
      seenProj.add(entry.target);
      animate(
        entry.target as HTMLElement,
        { y: [24, 0], opacity: [0, 1] },
        {
          duration: 0.6,
          ease: [0.16, 1, 0.3, 1],
        }
      );
    });

    // ── Skill groups (once) ─────────────────────────────────────
    const seenSkill = new Set<Element>();
    inView('.skill-group', (entry) => {
      if (seenSkill.has(entry.target)) return;
      seenSkill.add(entry.target);
      animate(
        entry.target as HTMLElement,
        { y: [20, 0], opacity: [0, 1] },
        {
          duration: 0.5,
          ease: [0.16, 1, 0.3, 1],
        }
      );
    });
  }
</script>

<script is:inline>
  // Nav scroll state
  const siteNav = document.getElementById('site-nav');
  if (siteNav) {
    window.addEventListener(
      'scroll',
      () => {
        siteNav.classList.toggle('scrolled', window.scrollY > 40);
      },
      { passive: true }
    );
  }

  // Parallax on hero star field + grid
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const gridBg = document.querySelector('.grid-bg');
        const stars = document.querySelector('.stars');
        if (gridBg) gridBg.style.transform = `translateY(${y * 0.08}px)`;
        if (stars) stars.style.transform = `translateY(${y * 0.05}px)`;
      },
      { passive: true }
    );
  }
</script>

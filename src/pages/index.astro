---
import Layout from '../layouts/Layout.astro';
import Quotes from '../components/Quotes.astro';
---

<Layout>
  <main class="text-center py-12">
    <!-- Hero Section -->
    <div class="mb-12">
      <h1
        class="text-4xl md:text-5xl font-bold text-[#fef5e7] mb-4"
        style="font-family: 'Space Grotesk', sans-serif; text-shadow: 3px 3px 0 #e94560, 6px 6px 0 rgba(0,0,0,0.2);"
      >
        Welcome to My Virtual Space
      </h1>
      <div
        class="w-32 h-1 mx-auto bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e] rounded-full mb-6"
      >
      </div>
      <p
        class="text-[#fef5e7]/80 text-lg max-w-xxl mx-auto"
        style="font-family: 'Outfit', sans-serif;"
      >
        Exploring the cosmos through code and science - one curiosity at a time.
      </p>
    </div>

    <!-- Decorative atomic element -->
    <div class="flex justify-center items-center gap-6 mb-8">
      <span class="text-[#e94560] text-2xl">*</span>
      <div class="w-3 h-3 rounded-full bg-[#f8b500]"></div>
      <span class="text-[#0f9b8e] text-2xl">*</span>
    </div>

    <Quotes />
  </main>
</Layout>

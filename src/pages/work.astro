---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1
        class="text-4xl md:text-5xl font-bold text-[#fef5e7] mb-4"
        style="font-family: 'Space Grotesk', sans-serif; text-shadow: 3px 3px 0 #e94560;"
      >
        Work Experience
      </h1>
      <div
        class="w-24 h-1 mx-auto bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e] rounded-full mb-4"
      >
      </div>
      <p class="text-[#fef5e7]/80 max-w-xl mx-auto" style="font-family: 'Outfit', sans-serif;">
        This page showcases the projects I've worked on throughout my career.
      </p>
    </div>

    <!-- Work Items -->
    <div class="space-y-8">
      <!-- Blue Origin -->
      <div
        id="work-blue"
        class="retro-card group hover:border-[#e94560] transition-all duration-300"
      >
        <div class="flex items-start gap-4">
          <div class="w-3 h-3 mt-2 rounded-full bg-[#e94560] group-hover:animate-pulse"></div>
          <div class="flex-1">
            <h2
              class="text-2xl font-bold text-[#e94560] mb-2 uppercase tracking-wider"
              style="font-family: 'Space Grotesk', sans-serif;"
            >
              Blue Origin
            </h2>
            <p class="text-[#fef5e7]/70" style="font-family: 'Outfit', sans-serif;">
              <!-- Add your Blue Origin experience description here -->
            </p>
          </div>
        </div>
      </div>

      <!-- ENSCO -->
      <div
        id="work-ensco"
        class="retro-card group hover:border-[#0f9b8e] transition-all duration-300"
      >
        <div class="flex items-start gap-4">
          <div class="w-3 h-3 mt-2 rounded-full bg-[#0f9b8e] group-hover:animate-pulse"></div>
          <div class="flex-1">
            <h2
              class="text-2xl font-bold text-[#0f9b8e] mb-2 uppercase tracking-wider"
              style="font-family: 'Space Grotesk', sans-serif;"
            >
              ENSCO, Inc.
            </h2>
            <p class="text-[#fef5e7]/70" style="font-family: 'Outfit', sans-serif;">
              <!-- Add your ENSCO experience description here -->
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

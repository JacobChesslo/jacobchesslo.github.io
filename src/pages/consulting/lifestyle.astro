---
import Layout from '../../layouts/Layout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jacob Chesslo - LGBTQ+ & Lifestyle Tech Consulting',
  description:
    'Tech consulting for LGBTQ+, kink, and lifestyle communities. Web development, apps, community platforms - built by someone in these spaces.',
  url: Astro.url.href,
  email: 'jacobchesslo@gmail.com',
  areaServed: 'Worldwide',
  serviceType: 'Web, app, and community-platform development for LGBTQ+ and lifestyle communities',
  founder: {
    '@type': 'Person',
    name: 'Jacob Chesslo',
    url: Astro.url.origin + '/',
    jobTitle: 'Software Engineer',
    knowsAbout: [
      'Web development',
      'Application development',
      'Community platforms',
      'Event technology',
      'Data privacy',
      'LGBTQ+ and lifestyle community technology',
    ],
    sameAs: ['https://github.com/JacobChesslo', 'https://linkedin.com/in/jacobchesslo'],
  },
};

// Single source of truth: renders both the FAQ accordion and FAQPage structured data
const faqs = [
  {
    q: 'Will you get what our community needs?',
    a: "Probably - I'm queer, in kink and lifestyle spaces myself, and I've run LGBTQ+ orgs. You won't be explaining the basics. If it's a corner I don't know well, I'll say so.",
  },
  {
    q: 'How do you handle member privacy?',
    a: "As a first-class concern. Data minimization, real access controls, and not collecting what you don't need. People in these spaces have real reasons to care - so do I.",
  },
  {
    q: 'Can you work discreetly?',
    a: "Yes. A lot of this work is sensitive. I'll sign an NDA and keep names and details to myself.",
  },
  {
    q: 'How do you price, and are you available?',
    a: "No rate cards yet - we scope a small first piece and go from there. I take on a couple of projects at a time, so reach out and we'll see if the timing works.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Single prefilled mailto reused by every CTA (cover, sticky, body) so they never drift
const mailto =
  'mailto:jacobchesslo@gmail.com?subject=LGBTQ%2B%20%26%20lifestyle%20tech&body=Hi%20Jacob%2C%0A%0AI%27m%20with%20%5Bcommunity%2Forg%5D%20and%20we%27re%20looking%20to%20build%2Ffix%20%5Bthe%20thing%5D.%20A%20bit%20of%20context%3A%0A%0A';
---

<Layout
  title="LGBTQ+ & Lifestyle Tech Consulting - Jacob Chesslo"
  description="Jacob Chesslo builds web, apps, and community platforms for LGBTQ+, kink, and lifestyle communities - software from someone actually in these spaces."
  fullWidth={true}
  ogImage="/og/consulting-lifestyle.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ── SCROLL SCENE ─────────────────────────────────────── -->
  <div class="scroll-scene" id="lifestyle-scene">
    <div class="sticky-stage">
      <canvas id="lifestyle-canvas" aria-hidden="true"></canvas>

      <div class="text-pill">
        <div class="pill-header">
          <a href="/consulting" class="back-link">&larr; Consulting</a>
          <span class="page-tag">LGBTQ+ &amp; Lifestyle</span>
          <h1 class="page-title">Tech built<br /><span class="accent">for your world.</span></h1>
        </div>
        <div class="pill-body">
          <p class="page-sub">
            Web, apps, and community platforms for LGBTQ+, kink, and lifestyle communities - built
            by someone who lives in these spaces.
          </p>
          <div class="pill-actions">
            <a href={mailto} class="cta-btn">Let's talk <span class="arr">&rarr;</span></a>
          </div>
        </div>
      </div>

      <div class="scene-progress" aria-hidden="true">
        <div class="scene-progress-fill" id="lifestyle-progress"></div>
      </div>

      <div class="overlay" id="ov1" aria-hidden="true">
        <p class="ov-line">Generic platforms.</p>
        <p class="ov-line">Communities treated as edge cases.</p>
        <p class="ov-line">Privacy as an afterthought.</p>
      </div>
      <div class="overlay" id="ov2" aria-hidden="true">
        <p class="ov-hero">Software built<br />for your people.</p>
        <p class="ov-sub">Not a generic SaaS with your logo on it.</p>
      </div>
      <div class="overlay" id="ov3" aria-hidden="true">
        <p class="ov-hero">Built from the inside.</p>
        <p class="ov-sub">Queer. In kink &amp; lifestyle. Years running LGBTQ+ orgs.</p>
      </div>

      <a
        href="#lifestyle-proof"
        class="scroll-cue"
        id="lifestyle-hint"
        aria-label="Skip the intro animation"
      >
        <svg
          viewBox="0 0 24 24"
          width="26"
          height="26"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- ── PROOF / CREDIBILITY BAND ──────────────────────────── -->
  <section class="proof-band" id="lifestyle-proof" aria-label="Why me">
    <p class="proof-lead">Tech for communities I&rsquo;m actually part of:</p>
    <div class="proof-metrics">
      <div class="proof-metric">
        <span class="proof-num">Insider</span>
        <span class="proof-cap">queer, in kink &amp; lifestyle spaces myself</span>
      </div>
      <div class="proof-metric">
        <span class="proof-num">Years in</span>
        <span class="proof-cap">running LGBTQ+ orgs &amp; events</span>
      </div>
      <div class="proof-metric">
        <span class="proof-num">Privacy-first</span>
        <span class="proof-cap">real stakes, handled as first-class</span>
      </div>
    </div>
    <div class="proof-affil">
      <span>LGBTQ+</span><span class="proof-dot">&middot;</span><span>Kink</span><span
        class="proof-dot">&middot;</span
      ><span>Lifestyle</span><span class="proof-dot">&middot;</span><span>Events</span>
    </div>
  </section>

  <!-- ── CONTENT ───────────────────────────────────────────── -->
  <article class="consult-body" id="lifestyle-details">
    <section class="content-section">
      <span class="section-kicker">01</span>
      <h2 class="section-heading">Why this matters</h2>
      <p>
        Most vendors treat LGBTQ+ and kink communities as edge cases to accommodate - not people to
        build for. You get software that technically works but misses what matters: the culture, the
        trust, the privacy, the way people actually connect.
      </p>
      <p>
        I'm not an outsider here. I'm queer, in kink and lifestyle communities, and I've spent years
        running LGBTQ+ orgs. I know what you need because I depend on this software too.
      </p>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">02</span>
      <h2 class="section-heading">What I can help with</h2>
      <div class="capability-grid">
        <div class="cap-card">
          <svg
            class="cap-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <h3 class="cap-title">Web &amp; App Dev</h3>
          <div class="cap-body">Full-stack sites, portals, and member areas.</div>
          <div class="cap-tech">TypeScript · Astro · React/Solid</div>
        </div>
        <div class="cap-card">
          <svg
            class="cap-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <h3 class="cap-title">Community Platforms</h3>
          <div class="cap-body">Members, events, and forums that feel right.</div>
          <div class="cap-tech">Onboarding · Forums · Memberships</div>
        </div>
        <div class="cap-card">
          <svg
            class="cap-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <h3 class="cap-title">Privacy &amp; Trust</h3>
          <div class="cap-body">Real privacy, built in from the start.</div>
          <div class="cap-tech">Data minimization · Access control</div>
        </div>
        <div class="cap-card">
          <svg
            class="cap-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
            <path d="M16 2v4M8 2v4M3 10h18"></path>
          </svg>
          <h3 class="cap-title">Event Tech</h3>
          <div class="cap-body">Registration, waivers, and check-in that work.</div>
          <div class="cap-tech">Tickets · Waivers · Scheduling</div>
        </div>
      </div>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">03</span>
      <h2 class="section-heading">Good fit for</h2>
      <ul class="fit-list">
        <li>LGBTQ+ organizations or community groups that have outgrown their current tools</li>
        <li>Kink or lifestyle event organizers who need better event infrastructure</li>
        <li>Small businesses serving these communities that need a real web presence</li>
        <li>Anyone tired of explaining their community's needs from scratch to every vendor</li>
      </ul>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">04</span>
      <h2 class="section-heading">How we'd start</h2>
      <ol class="process-list">
        <li class="process-step">
          <span class="process-num">01</span>
          <div class="process-text">
            <strong>You tell me what your community needs.</strong>
            A platform that's outgrown its tools, an event that needs better infrastructure, a site that
            finally fits.
          </div>
        </li>
        <li class="process-step">
          <span class="process-num">02</span>
          <div class="process-text">
            <strong>A relaxed call - no pitch.</strong>
            I won't make you explain your community from scratch. We just see whether it's a fit.
          </div>
        </li>
        <li class="process-step">
          <span class="process-num">03</span>
          <div class="process-text">
            <strong>We start small and concrete.</strong>
            One real piece with a clear outcome, so you can judge the work before going further.
          </div>
        </li>
      </ol>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">05</span>
      <h2 class="section-heading">Questions</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary class="faq-q">
                {f.q}
                <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <div class="divider-line"></div>

    <section class="cta-section">
      <p class="cta-note">
        This is a newer direction for me, so I'm starting with real conversations - no packages, no
        rate cards. If you have something to build or fix, reach out &mdash; I reply within a day.
      </p>
      <div class="cta-actions">
        <a href={mailto} class="cta-btn-body"
          >Start the conversation <span class="arr">&rarr;</span></a
        >
        <button
          type="button"
          class="cta-copy"
          data-email="jacobchesslo@gmail.com"
          aria-label="Copy email address jacobchesslo@gmail.com to clipboard"
        >
          <svg class="cta-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="cta-copy-label" aria-live="polite">jacobchesslo@gmail.com</span>
        </button>
      </div>
    </section>
  </article>

  <a href={mailto} class="sticky-cta" id="lifestyle-sticky">
    <span class="sticky-cta-tag">LGBTQ+ &amp; Lifestyle</span>
    <span class="sticky-cta-action">Let's talk <span class="arr">&rarr;</span></span>
  </a>
</Layout>

<script>
  const scene = document.getElementById('lifestyle-scene')! as HTMLElement;
  const canvas = document.getElementById('lifestyle-canvas')! as HTMLCanvasElement;
  const hintEl = document.getElementById('lifestyle-hint')! as HTMLElement;
  const progressEl = document.getElementById('lifestyle-progress')! as HTMLElement;
  const pillEl = document.querySelector('.text-pill')! as HTMLElement;
  const stickyEl = document.getElementById('lifestyle-sticky')! as HTMLElement;
  const ov1El = document.getElementById('ov1')! as HTMLElement;
  const ov2El = document.getElementById('ov2')! as HTMLElement;
  const ov3El = document.getElementById('ov3')! as HTMLElement;
  const ctx = canvas.getContext('2d')!;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pride rainbow - one hue per cluster
  const CLUSTER_COLORS = [
    'oklch(62% 0.25 18', // red
    'oklch(66% 0.22 55', // orange
    'oklch(82% 0.19 98', // yellow
    'oklch(64% 0.21 148', // green
    'oklch(62% 0.21 245', // blue
    'oklch(62% 0.22 295', // violet
  ];

  let W = 0,
    H = 0;
  let rawProgress = 0,
    displayProgress = 0;
  let sceneOffscreen = false; // true once scrolled past the scene → throttle the backdrop
  let ctaInView = false; // true when the final CTA is on screen → hide the redundant sticky CTA
  let lastDraw = 0;

  // ── Cluster setup ─────────────────────────────────────────
  const CLUSTER_N = 6;
  const NODES_EACH = 15;

  interface Node {
    rx: number;
    ry: number; // random start
    cx: number;
    cy: number; // cluster center
    tx: number;
    ty: number; // target within cluster
    x: number;
    y: number; // current
    vx: number;
    vy: number;
    cluster: number;
    ph: number;
    sp: number;
  }

  let nodes: Node[] = [];

  function clusterCenter(i: number): { x: number; y: number } {
    const angle = (i / CLUSTER_N) * Math.PI * 2 - Math.PI / 2;
    const rx = Math.min(W, H) * 0.28;
    const ry = Math.min(W, H) * 0.25;
    return {
      x: W / 2 + Math.cos(angle) * rx,
      y: H / 2 + Math.sin(angle) * ry,
    };
  }

  function initNodes() {
    nodes = [];
    for (let ci = 0; ci < CLUSTER_N; ci++) {
      const { x: cx, y: cy } = clusterCenter(ci);
      for (let j = 0; j < NODES_EACH; j++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 20 + Math.random() * 50;
        nodes.push({
          rx: Math.random() * W,
          ry: Math.random() * H,
          cx,
          cy,
          tx: cx + Math.cos(angle) * dist,
          ty: cy + Math.sin(angle) * dist,
          x: 0,
          y: 0,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          cluster: ci,
          ph: Math.random() * Math.PI * 2,
          sp: 0.35 + Math.random() * 0.8,
        });
      }
    }
    nodes.forEach((n) => {
      n.x = n.rx;
      n.y = n.ry;
    });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  function resize() {
    const newW = canvas.offsetWidth,
      newH = canvas.offsetHeight;
    const widthChanged = Math.abs(newW - W) > 20;
    W = newW;
    H = newH;
    if (widthChanged || nodes.length === 0) {
      canvas.width = Math.round(W * devicePixelRatio);
      canvas.height = Math.round(H * devicePixelRatio);
      ctx.scale(devicePixelRatio, devicePixelRatio);
      initNodes();
    }
  }

  function eio(t: number) {
    return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
  }
  function clamp(v: number, a: number, b: number) {
    return Math.max(a, Math.min(b, v));
  }
  // Trapezoidal hold: quick fade in, full opacity across the band, quick fade out
  function band(p: number, a: number, b: number, f = 0.04) {
    return clamp((p - a) / f, 0, 1) * clamp((b - p) / f, 0, 1);
  }

  function draw(ts: number) {
    ctx.clearRect(0, 0, W, H);

    displayProgress += (rawProgress - displayProgress) * (reduced ? 1 : 0.09);
    const prog = reduced ? 1 : displayProgress; // smoothed: drives the animation morph
    const ui = reduced ? 0 : rawProgress; // raw scroll drives captions + chrome; reduced keeps the cover
    const gather = clamp((prog - 0.1) / 0.3, 0, 1); // nodes converge to clusters
    const intra = clamp((prog - 0.48) / 0.24, 0, 1); // within-cluster connections
    const inter = clamp((prog - 0.78) / 0.2, 0, 1); // between-cluster bridges

    // Update node positions
    for (const n of nodes) {
      if (gather < 1) {
        const drift = (1 - gather) * 0.5;
        n.rx += n.vx * drift;
        n.ry += n.vy * drift;
        if (n.rx < 0 || n.rx > W) n.vx *= -1;
        if (n.ry < 0 || n.ry > H) n.vy *= -1;
      }
      const e = eio(gather);
      n.x = n.rx + (n.tx - n.rx) * e;
      n.y = n.ry + (n.ty - n.ry) * e;
    }

    // Within-cluster connections (cluster color)
    if (intra > 0) {
      const maxD = 90;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          if (nodes[i].cluster !== nodes[j].cluster) continue;
          const dx = nodes[j].x - nodes[i].x,
            dy = nodes[j].y - nodes[i].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < maxD) {
            const a = (1 - d / maxD) * intra * 0.7;
            ctx.beginPath();
            ctx.strokeStyle = `${CLUSTER_COLORS[nodes[i].cluster]} / ${a})`;
            ctx.lineWidth = 0.7 + inter * 0.3;
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
    }

    // Between-cluster bridges (gradient between adjacent cluster colors)
    if (inter > 0) {
      for (let ci = 0; ci < CLUSTER_N; ci++) {
        const cj = (ci + 1) % CLUSTER_N;
        const aN = nodes.filter((n) => n.cluster === ci);
        const bN = nodes.filter((n) => n.cluster === cj);
        let best = Infinity,
          bai = 0,
          bbj = 0;
        for (let ai = 0; ai < aN.length; ai++) {
          for (let bj = 0; bj < bN.length; bj++) {
            const dx = bN[bj].x - aN[ai].x,
              dy = bN[bj].y - aN[ai].y;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < best) {
              best = d;
              bai = ai;
              bbj = bj;
            }
          }
        }
        const grad = ctx.createLinearGradient(aN[bai].x, aN[bai].y, bN[bbj].x, bN[bbj].y);
        grad.addColorStop(0, `${CLUSTER_COLORS[ci]} / ${inter * 0.45})`);
        grad.addColorStop(1, `${CLUSTER_COLORS[cj]} / ${inter * 0.45})`);
        ctx.beginPath();
        ctx.strokeStyle = grad;
        ctx.lineWidth = 0.9;
        ctx.setLineDash([3, 5]);
        ctx.moveTo(aN[bai].x, aN[bai].y);
        ctx.lineTo(bN[bbj].x, bN[bbj].y);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    }

    // Nodes (cluster color)
    for (const n of nodes) {
      const col = CLUSTER_COLORS[n.cluster];
      const pulse = Math.sin(ts * 0.001 * n.sp + n.ph) * 0.5 + 0.5;
      // Isolated nodes read as distinct points of light, then settle as they gather
      const baseA = 0.44 + gather * 0.4 + inter * 0.18;
      const r = 1.7 + (1 - gather) * 0.5 + pulse * 0.7 + inter * 0.8;

      if (intra > 0) {
        const gr = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 5);
        gr.addColorStop(0, `${col} / ${intra * 0.22})`);
        gr.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(n.x, n.y, r * 5, 0, Math.PI * 2);
        ctx.fillStyle = gr;
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      ctx.fillStyle = `${col} / ${baseA + pulse * 0.12})`;
      ctx.fill();
    }

    // Beat captions: solid holds mapped to the cluster animation phases
    ov1El.style.opacity = String(band(ui, 0.08, 0.32));
    ov2El.style.opacity = String(band(ui, 0.38, 0.64));
    ov3El.style.opacity = String(band(ui, 0.7, 0.99));

    // Cover fades into the beat captions; sticky CTA carries conversion once we're past it
    pillEl.classList.toggle('compact', ui > 0.07);
    stickyEl.classList.toggle('visible', ui > 0.12 && !ctaInView);
    const hintOpacity = clamp(1 - ui * 14, 0, 1);
    hintEl.style.opacity = String(hintOpacity);
    hintEl.style.visibility = hintOpacity < 0.05 ? 'hidden' : 'visible'; // drop from tab order when faded
    progressEl.style.transform = `scaleX(${ui})`;
  }

  function updateProgress() {
    const rect = scene.getBoundingClientRect();
    const scrollable = scene.offsetHeight - window.innerHeight;
    if (scrollable > 0) rawProgress = Math.max(0, Math.min(1, -rect.top / scrollable));
    // Once we're past the scene into the body, fade the canvas to a faint backdrop
    const past = -rect.top - scrollable;
    const fade = clamp(past / (window.innerHeight * 0.6), 0, 1);
    // Floor at ~0.09: the multi-colour clusters are busier than Science's mono attractor,
    // so the body-state backdrop is kept a touch fainter for text readability.
    canvas.style.opacity = String(1 - fade * 0.91);
    sceneOffscreen = past > window.innerHeight * 0.6; // fully faded → no longer the focus
  }

  resize();
  updateProgress();
  window.addEventListener(
    'resize',
    () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    },
    { passive: true }
  );
  window.addEventListener('scroll', updateProgress, { passive: true });

  // Gentle scroll-reveal for the body sections (added in JS so no-JS still shows everything)
  if (!reduced) {
    const revealEls = document.querySelectorAll<HTMLElement>(
      '.proof-band, .consult-body .content-section, .cta-section'
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    revealEls.forEach((el) => {
      el.classList.add('reveal');
      io.observe(el);
    });
  }

  // Hide the sticky CTA once the real CTA section is on screen (avoid redundant CTAs at conversion)
  const ctaSection = document.querySelector('.cta-section');
  if (ctaSection) {
    new IntersectionObserver(
      ([entry]) => {
        ctaInView = entry.isIntersecting;
      },
      { rootMargin: '0px 0px -10% 0px' }
    ).observe(ctaSection);
  }

  // Copy-email fallback so the address is capturable even when mailto does nothing
  const copyBtn = document.querySelector<HTMLButtonElement>('.cta-copy');
  if (copyBtn) {
    const label = copyBtn.querySelector<HTMLElement>('.cta-copy-label')!;
    const original = label.textContent;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email || '');
      } catch {
        // Clipboard blocked (insecure context / old browser) - select the address for manual copy
        const sel = window.getSelection();
        if (sel) {
          const range = document.createRange();
          range.selectNodeContents(label);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        return;
      }
      copyBtn.classList.add('copied');
      label.textContent = 'Copied to clipboard ✓';
      window.setTimeout(() => {
        copyBtn.classList.remove('copied');
        label.textContent = original;
      }, 1800);
    });
  }

  // Snappier "skip" than the native 1.2s smooth-scroll over the long scene (eased ~0.65s)
  const skipCue = document.getElementById('lifestyle-hint');
  const proof = document.getElementById('lifestyle-proof');
  if (skipCue && proof && !reduced) {
    skipCue.addEventListener('click', (e) => {
      e.preventDefault();
      const startY = window.scrollY;
      const dist = proof.offsetTop - 84 - startY;
      const t0 = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / 650);
        // behavior:'instant' so our easing drives it, not the global scroll-behavior:smooth
        window.scrollTo({ top: startY + dist * ease(t), behavior: 'instant' });
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  if (reduced) {
    rawProgress = 1;
    draw(0);
  } else {
    function tick(ts: number) {
      // Skip all physics/drawing while the tab is hidden - nobody's watching, save the battery
      if (document.hidden) {
        requestAnimationFrame(tick);
        return;
      }
      // Full 60fps while the scene is the focus; throttle to ~12fps once it's a faint backdrop
      if (!sceneOffscreen || ts - lastDraw > 80) {
        draw(ts);
        lastDraw = ts;
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>


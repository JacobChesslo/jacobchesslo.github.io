---
import Layout from '../../layouts/Layout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jacob Chesslo — Science & Simulation Consulting',
  description:
    'Scientific software engineering consulting. HPC optimization, simulation pipelines, legacy code modernization, research-to-production bridging.',
  url: 'https://jacobchesslo.com/consulting/science',
  email: 'jacobchesslo@gmail.com',
  founder: { '@type': 'Person', name: 'Jacob Chesslo', url: 'https://jacobchesslo.com' },
};
---

<Layout
  title="Science & Simulation Consulting — Jacob Chesslo"
  description="Jacob Chesslo consults on scientific software engineering — HPC optimization, simulation pipelines, and bridging research code to production."
  fullWidth={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <div class="scroll-scene" id="science-scene">
    <div class="sticky-stage">
      <canvas id="science-canvas" aria-hidden="true"></canvas>

      <div class="text-pill">
        <div class="pill-header">
          <a href="/consulting" class="back-link">&larr; Consulting</a>
          <span class="page-tag">Science &amp; Engineering</span>
          <h1 class="page-title">Research code<br /><span class="accent">that ships.</span></h1>
        </div>
        <div class="pill-body">
          <p class="page-sub">
            I bridge the gap between research software and engineering-grade systems — making
            computation fast, correct, and deployable when the stakes are high.
          </p>
          <a href="mailto:jacobchesslo@gmail.com" class="cta-btn">Let's talk &rarr;</a>
        </div>
      </div>

      <div class="overlay" id="ov1">
        <p class="ov-line">Prototype Python.</p>
        <p class="ov-line">Legacy Fortran.</p>
        <p class="ov-line">Simulations too slow to iterate on.</p>
      </div>
      <div class="overlay" id="ov2">
        <p class="ov-hero">Every complex system<br />has structure.</p>
        <p class="ov-sub">I find it — and make it ship.</p>
      </div>
      <div class="overlay" id="ov3">
        <p class="ov-eq">dx/dt = σ(y−x)</p>
        <p class="ov-eq">dy/dt = x(ρ−z)−y</p>
        <p class="ov-eq">dz/dt = xy−βz</p>
        <p class="ov-params">σ=10 &ensp; ρ=28 &ensp; β=8/3</p>
      </div>

      <div class="phase-label" id="science-phase">raw simulation data</div>
      <div class="scroll-hint" id="scroll-hint">scroll to explore &darr;</div>
    </div>
  </div>

  <article class="consult-body">
    <section class="content-section">
      <h2 class="section-heading">The problem I solve</h2>
      <p>
        Scientists write code that works scientifically. It runs on their laptop, produces correct
        results, and solves the problem they had. Then someone asks it to run at scale, be handed
        off to another team, or survive a production environment — and it falls apart.
      </p>
      <p>
        That's the gap. Not because the scientist did something wrong, but because research code and
        production software are optimized for different things. I've lived on both sides of that
        line — physics research at CERN, HPC scientific software at a defense lab, and now building
        systems that run millions of tasks at 99.99%+ uptime in aerospace.
      </p>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <h2 class="section-heading">What I bring</h2>
      <div class="capability-grid">
        <div class="cap-card">
          <div class="cap-title">HPC &amp; Scientific Computing</div>
          <div class="cap-body">
            Python, Fortran, C/C++, Slurm, PBS, Torque. Simulation pipelines at scale. I've reduced
            bottleneck runtimes by 5 orders of magnitude and cut end-to-end workflows by 10&times;.
          </div>
        </div>
        <div class="cap-card">
          <div class="cap-title">Physics Domain</div>
          <div class="cap-body">
            Particle physics (CERN ROOT, MadGraph5, Pythia8), IR spectroscopy, acoustic propagation,
            aerospace avionics verification. I understand the science, not just the code.
          </div>
        </div>
        <div class="cap-card">
          <div class="cap-title">Modernization</div>
          <div class="cap-body">
            Legacy MATLAB and Fortran to modern Python. Architecture that a team can maintain and
            extend. Type-safe, tested, documented — not just "it runs."
          </div>
        </div>
        <div class="cap-card">
          <div class="cap-title">Production Engineering</div>
          <div class="cap-body">
            Systems that survive contact with real environments. Compliance-aware design (NIST
            800-53, NASA NPR 7123). Deployment, monitoring, and handoff that stick.
          </div>
        </div>
      </div>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <h2 class="section-heading">Good fit for</h2>
      <ul class="fit-list">
        <li>
          Research labs or universities with prototype code that needs to scale or be handed off
        </li>
        <li>
          Teams stuck on legacy MATLAB or Fortran that needs modernizing without breaking the
          science
        </li>
        <li>Startups running simulations too slow to iterate on</li>
        <li>Anyone who needs a physicist who can also ship software</li>
      </ul>
    </section>

    <div class="divider-line"></div>

    <section class="cta-section">
      <p class="cta-note">
        I'm new to consulting, so I'm selective and engaged — not juggling ten clients at once. If
        this sounds like a fit, send me an email and we'll figure out if it makes sense.
      </p>
      <a href="mailto:jacobchesslo@gmail.com" class="cta-btn-body">jacobchesslo@gmail.com</a>
    </section>
  </article>
</Layout>

<script>
  const scene = document.getElementById('science-scene')! as HTMLElement;
  const canvas = document.getElementById('science-canvas')! as HTMLCanvasElement;
  const phaseEl = document.getElementById('science-phase')! as HTMLElement;
  const hintEl = document.getElementById('scroll-hint')! as HTMLElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Lorenz: dx/dt = σ(y−x), dy/dt = x(ρ−z)−y, dz/dt = xy−βz
  const SIGMA = 10,
    RHO = 28,
    BETA = 8 / 3,
    DT = 0.005;
  function lorenzStep(x: number, y: number, z: number): [number, number, number] {
    return [x + SIGMA * (y - x) * DT, y + (x * (RHO - z) - y) * DT, z + (x * y - BETA * z) * DT];
  }

  const N = 64,
    TRAIL = 90;
  const PHASES = ['raw simulation data', 'lorenz attractor'];

  interface Particle {
    rx: number;
    ry: number;
    lx: number;
    ly: number;
    lz: number;
    trail: [number, number][];
    x: number;
    y: number;
    vx: number;
    vy: number;
    hue: number;
  }

  let W = 0,
    H = 0;
  let rawProgress = 0,
    displayProgress = 0;
  let pts: Particle[] = [];
  let clouds: { x: number; y: number; r: number }[] = [];

  const ov1El = document.getElementById('ov1')! as HTMLElement;
  const ov2El = document.getElementById('ov2')! as HTMLElement;
  const ov3El = document.getElementById('ov3')! as HTMLElement;

  // Project Lorenz x-z plane → canvas; attractor spans x∈[-22,22], z∈[4,46]
  function project(lx: number, lz: number): [number, number] {
    const scale = Math.min(W, H) / 50;
    return [W / 2 + lx * scale, H * 0.52 - (lz - 25) * scale];
  }

  function initParticles() {
    pts = [];
    clouds = [];
    for (let i = 0; i < N; i++) {
      let lx = 0.1 + (Math.random() - 0.5) * 8;
      let ly = 0.1 + (Math.random() - 0.5) * 8;
      let lz = 20 + (Math.random() - 0.5) * 8;
      for (let w = 0; w < 2000; w++) [lx, ly, lz] = lorenzStep(lx, ly, lz);
      const stagger = Math.floor(Math.random() * 600);
      for (let s = 0; s < stagger; s++) [lx, ly, lz] = lorenzStep(lx, ly, lz);
      pts.push({
        rx: Math.random() * W,
        ry: Math.random() * H,
        lx,
        ly,
        lz,
        trail: [],
        x: 0,
        y: 0,
        vx: (Math.random() - 0.5) * 0.45,
        vy: (Math.random() - 0.5) * 0.45,
        hue: 275 + (Math.random() - 0.5) * 50,
      });
      pts[i].x = pts[i].rx;
      pts[i].y = pts[i].ry;
    }
    for (let i = 0; i < 8; i++)
      clouds.push({ x: Math.random() * W, y: Math.random() * H, r: 60 + Math.random() * 90 });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  function resize() {
    const newW = canvas.offsetWidth,
      newH = canvas.offsetHeight;
    const widthChanged = Math.abs(newW - W) > 20;
    W = newW;
    H = newH;
    if (widthChanged || pts.length === 0) {
      // Only reset canvas dimensions on a real resize — assigning these clears the canvas
      canvas.width = Math.round(W * devicePixelRatio);
      canvas.height = Math.round(H * devicePixelRatio);
      ctx.scale(devicePixelRatio, devicePixelRatio);
      initParticles();
    }
    // Height-only (iOS URL bar): update H for projection math, never touch canvas dims
  }

  function eio(t: number) {
    return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
  }
  function clamp(v: number, a: number, b: number) {
    return Math.max(a, Math.min(b, v));
  }
  function phase(p: number, start: number, len: number) {
    return clamp((p - start) / len, 0, 1);
  }
  function plateau(p: number, s: number, e: number) {
    const c = (s + e) / 2,
      hw = (e - s) / 2;
    return Math.max(0, 1 - Math.abs(p - c) / hw);
  }

  function draw(_ts: number) {
    ctx.clearRect(0, 0, W, H);
    displayProgress += (rawProgress - displayProgress) * (reduced ? 1 : 0.045);
    const prog = reduced ? 1 : displayProgress;

    const lorenz = eio(phase(prog, 0.12, 0.48)); // scatter → attractor, done ~0.60

    // Scatter blobs fade as attractor forms
    const cloudA = clamp(1 - lorenz * 2.5, 0, 1);
    if (cloudA > 0.01) {
      for (const cl of clouds) {
        const g = ctx.createRadialGradient(cl.x, cl.y, 0, cl.x, cl.y, cl.r);
        g.addColorStop(0, `oklch(55% 0.22 295 / ${cloudA * 0.11})`);
        g.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(cl.x, cl.y, cl.r, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
      }
    }

    // Step Lorenz + lerp positions from scatter → attractor
    for (const p of pts) {
      [p.lx, p.ly, p.lz] = lorenzStep(p.lx, p.ly, p.lz);
      const [px, py] = project(p.lx, p.lz);
      if (lorenz < 1) {
        p.rx += p.vx * (1 - lorenz) * 0.5;
        p.ry += p.vy * (1 - lorenz) * 0.5;
        if (p.rx < 0 || p.rx > W) p.vx *= -1;
        if (p.ry < 0 || p.ry > H) p.vy *= -1;
      }
      p.x = p.rx + (px - p.rx) * lorenz;
      p.y = p.ry + (py - p.ry) * lorenz;
      if (lorenz > 0.2) {
        p.trail.push([p.x, p.y]);
        if (p.trail.length > TRAIL) p.trail.shift();
      } else {
        p.trail = [];
      }
    }

    // Trails
    const trailA = clamp((lorenz - 0.2) / 0.5, 0, 1);
    if (trailA > 0) {
      for (const p of pts) {
        if (p.trail.length < 3) continue;
        ctx.beginPath();
        ctx.moveTo(p.trail[0][0], p.trail[0][1]);
        for (let i = 1; i < p.trail.length; i++) ctx.lineTo(p.trail[i][0], p.trail[i][1]);
        ctx.strokeStyle = `oklch(62% 0.22 ${p.hue} / ${trailA * 0.28})`;
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    }

    // Particles
    for (const p of pts) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = `oklch(70% 0.2 ${p.hue} / ${0.3 + lorenz * 0.35})`;
      ctx.fill();
    }

    // HTML overlay alphas
    ov1El.style.opacity = String(plateau(prog, 0.03, 0.28));
    ov2El.style.opacity = String(plateau(prog, 0.3, 0.58));
    ov3El.style.opacity = String(plateau(prog, 0.68, 0.95));

    // Phase label
    const idx = prog < 0.6 ? 0 : 1;
    if (phaseEl.dataset.idx !== String(idx)) {
      phaseEl.dataset.idx = String(idx);
      phaseEl.style.opacity = '0';
      setTimeout(() => {
        phaseEl.textContent = PHASES[idx];
        phaseEl.style.opacity = '1';
      }, 120);
    }
    hintEl.style.opacity = String(clamp(1 - prog * 12, 0, 1));
  }

  function updateProgress() {
    const rect = scene.getBoundingClientRect();
    const scrollable = scene.offsetHeight - window.innerHeight;
    if (scrollable > 0) rawProgress = Math.max(0, Math.min(1, -rect.top / scrollable));
  }

  resize();
  window.addEventListener(
    'resize',
    () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    },
    { passive: true }
  );
  window.addEventListener('scroll', updateProgress, { passive: true });

  if (reduced) {
    rawProgress = 1;
    draw(0);
  } else {
    function tick(ts: number) {
      draw(ts);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>

<style>
  .scroll-scene {
    height: 700vh;
    position: relative;
  }

  .sticky-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  #science-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sticky-stage::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 140px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* Text pill: always visible, frosted glass, bottom-left */
  .text-pill {
    position: absolute;
    bottom: 3rem;
    left: clamp(1.5rem, 5vw, 4rem);
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: oklch(3% 0.006 264 / 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem 2rem;
    z-index: 2;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .back-link:hover {
    color: var(--accent-bright);
  }

  .page-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-bright);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    color: var(--text);
  }
  .page-title .accent {
    color: var(--accent-bright);
  }

  .page-sub {
    font-size: 0.97rem;
    color: var(--text-dim);
    font-weight: 400;
    line-height: 1.65;
  }

  .cta-btn {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    color: var(--bg);
    background: var(--accent-bright);
    padding: 0.55rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    transition:
      background var(--dur-fast),
      transform var(--dur-fast);
  }
  .cta-btn:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  .phase-label {
    position: absolute;
    top: 5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-bright);
    white-space: nowrap;
    background: oklch(3% 0.006 264 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid oklch(55% 0.22 295 / 0.25);
    border-radius: 100px;
    padding: 0.45rem 1.1rem;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  /* Scroll hint: bottom-center */
  .scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    transition: opacity 0.3s ease;
    z-index: 2;
    animation: hint-pulse 2s ease-in-out infinite;
  }
  @keyframes hint-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  /* ── Scroll overlays ──────────────────────────────── */
  .overlay {
    position: absolute;
    right: clamp(2rem, 6vw, 5rem);
    top: 50%;
    transform: translateY(-50%);
    text-align: right;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 2;
    pointer-events: none;
    max-width: 260px;
  }

  .ov-line {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    line-height: 2;
    margin: 0;
  }

  .ov-hero {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .ov-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
    margin: 0;
  }

  .ov-eq {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    color: oklch(72% 0.18 295);
    line-height: 1.9;
    margin: 0;
  }

  .ov-params {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin: 0.4rem 0 0;
  }

  /* ── Article body ─────────────────────────────────── */
  .consult-body {
    max-width: 64ch;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .divider-line {
    height: 1px;
    background: var(--border);
    margin: 2.5rem 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .content-section p {
    color: var(--text-dim);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .content-section p:last-child {
    margin-bottom: 0;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .cap-card {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .cap-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-bright);
    margin-bottom: 0.5rem;
  }
  .cap-body {
    font-size: 0.87rem;
    color: var(--text-dim);
    line-height: 1.65;
  }

  .fit-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .fit-list li {
    font-size: 0.92rem;
    color: var(--text-dim);
    padding-left: 1.2rem;
    position: relative;
    line-height: 1.6;
  }
  .fit-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .cta-note {
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .cta-btn-body {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--bg);
    background: var(--accent-bright);
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    transition:
      background var(--dur-fast),
      transform var(--dur-fast);
  }
  .cta-btn-body:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .sticky-stage {
      height: 100svh;
    }

    .text-pill {
      display: contents;
    }

    .pill-header {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      max-width: calc(100vw - 2.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: oklch(3% 0.006 264 / 0.82);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      z-index: 2;
    }

    .pill-body {
      position: absolute;
      bottom: 1.5rem;
      left: 1.25rem;
      max-width: calc(100vw - 2.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      background: oklch(3% 0.006 264 / 0.82);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      z-index: 2;
    }

    .page-title {
      font-size: 1.6rem;
    }

    .overlay {
      display: none;
    }

    .phase-label {
      display: none;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jacob Chesslo - Science & Simulation Consulting',
  description:
    'Scientific software engineering consulting. HPC optimization, simulation pipelines, legacy code modernization, research-to-production bridging.',
  url: Astro.url.href,
  email: 'jacobchesslo@gmail.com',
  areaServed: 'Worldwide',
  serviceType: 'Scientific software engineering consulting',
  founder: {
    '@type': 'Person',
    name: 'Jacob Chesslo',
    url: Astro.url.origin + '/',
    jobTitle: 'Software Engineer & Physicist',
    knowsAbout: [
      'High-performance computing',
      'Scientific computing',
      'Computational physics',
      'Simulation pipelines',
      'Research software engineering',
      'Legacy code modernization',
    ],
    sameAs: ['https://github.com/JacobChesslo', 'https://linkedin.com/in/jacobchesslo'],
  },
};

// Single source of truth: renders both the FAQ accordion and FAQPage structured data
const faqs = [
  {
    q: 'Are you taking on work right now?',
    a: "Yes - a project or two at a time, so I stay hands-on. If timing is tight, say so and I'll be straight about whether I can do it justice.",
  },
  {
    q: 'Remote or on-site?',
    a: 'Remote by default. I can travel for a kickoff or for work that has to happen on-site.',
  },
  {
    q: 'How do you price?',
    a: 'No rate cards yet. We scope a small first piece, agree on it, and go from there - hourly or fixed, whatever fits the work.',
  },
  {
    q: 'Can you handle sensitive work?',
    a: "I've worked in defense and aerospace under NDA and compliance regimes (NIST 800-53, NASA NPR 7123). Happy to sign an NDA before we get into specifics.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Single prefilled mailto reused by every CTA (cover, sticky, body) so they never drift
const mailto =
  'mailto:jacobchesslo@gmail.com?subject=Science%20%26%20simulation%20consulting&body=Hi%20Jacob%2C%0A%0AI%27m%20working%20on%20%5Bproject%5D%20and%20could%20use%20help%20with%20%5Bthe%20problem%5D.%20A%20bit%20of%20context%3A%0A%0A';
---

<Layout
  title="Science & Simulation Consulting - Jacob Chesslo"
  description="Jacob Chesslo consults on scientific software engineering - HPC optimization, simulation pipelines, and bridging research code to production."
  fullWidth={true}
  ogImage="/og/consulting-science.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="scroll-scene" id="science-scene">
    <div class="sticky-stage">
      <canvas id="science-canvas" aria-hidden="true"></canvas>

      <div class="text-pill">
        <div class="pill-header">
          <a href="/consulting" class="back-link">&larr; Consulting</a>
          <span class="page-tag">Science &amp; Engineering</span>
          <h1 class="page-title">Research code<br /><span class="accent">that ships.</span></h1>
        </div>
        <div class="pill-body">
          <p class="page-sub">
            I turn research code into production systems - fast, correct, and deployable when the
            stakes are high.
          </p>
          <div class="pill-actions">
            <a href={mailto} class="cta-btn">Let's talk <span class="arr">&rarr;</span></a>
          </div>
        </div>
      </div>

      <div class="scene-progress" aria-hidden="true">
        <div class="scene-progress-fill" id="science-progress"></div>
      </div>

      <div class="overlay" id="ov1" aria-hidden="true">
        <p class="ov-line">Prototype Python.</p>
        <p class="ov-line">Legacy Fortran.</p>
        <p class="ov-line">Simulations too slow to iterate on.</p>
      </div>
      <div class="overlay" id="ov2" aria-hidden="true">
        <p class="ov-hero">Every complex system has structure.</p>
        <p class="ov-sub">I find it - and make it ship.</p>
      </div>
      <div class="overlay" id="ov3" aria-hidden="true">
        <p class="ov-eq">dx/dt = σ(y−x)</p>
        <p class="ov-eq">dy/dt = x(ρ−z)−y</p>
        <p class="ov-eq">dz/dt = xy−βz</p>
        <p class="ov-eq-caption">Elegant on paper. Brutal at scale.</p>
      </div>

      <a
        href="#science-proof"
        class="scroll-cue"
        id="scroll-hint"
        aria-label="Skip the intro animation"
      >
        <svg
          viewBox="0 0 24 24"
          width="26"
          height="26"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </div>

  <section class="proof-band" id="science-proof" aria-label="Track record">
    <p class="proof-lead">Structure, found and shipped &mdash; in the real world:</p>
    <div class="proof-metrics">
      <div class="proof-metric">
        <span class="proof-num" aria-label="5 orders" data-to="5" data-dec="0" data-suffix=" orders"
          >5 orders</span
        >
        <span class="proof-cap">of magnitude faster &mdash; hours to milliseconds</span>
      </div>
      <div class="proof-metric">
        <span class="proof-num" aria-label="10 times" data-to="10" data-dec="0" data-suffix="×"
          >10&times;</span
        >
        <span class="proof-cap">faster end-to-end workflows</span>
      </div>
      <div class="proof-metric">
        <span
          class="proof-num"
          aria-label="99.99 percent or more"
          data-to="99.99"
          data-dec="2"
          data-suffix="%+">99.99%+</span
        >
        <span class="proof-cap">uptime across millions of tasks</span>
      </div>
    </div>
    <div class="proof-affil">
      <span>CERN</span><span class="proof-dot">&middot;</span><span>Defense Lab</span><span
        class="proof-dot">&middot;</span
      ><span>Aerospace</span>
    </div>
    <a href="/cv" class="proof-link">See the full background <span class="arr">&rarr;</span></a>
  </section>

  <article class="consult-body" id="science-details">
    <section class="content-section">
      <span class="section-kicker">01</span>
      <h2 class="section-heading">The problem I solve</h2>
      <p>
        Research code works on a laptop. Then it has to run at scale, get handed to another team, or
        survive production - and it falls apart. Not because the scientist erred: research code and
        production software optimize for different things.
      </p>
      <p>
        I've lived on both sides of that line - physics at CERN, HPC at a defense lab, and now
        systems running millions of tasks at 99.99%+ uptime in aerospace.
      </p>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">02</span>
      <h2 class="section-heading">What I bring</h2>
      <div class="capability-grid">
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="5" width="14" height="14" rx="2"></rect>
            <rect x="9" y="9" width="6" height="6"></rect>
            <path
              d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"
              stroke-linecap="round"></path>
          </svg>
          <h3 class="cap-title">HPC &amp; Computing</h3>
          <div class="cap-body">Simulation pipelines that scale.</div>
          <div class="cap-tech">Python · Fortran · C/C++ · Slurm/PBS</div>
        </div>
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"></circle>
            <ellipse cx="12" cy="12" rx="10" ry="4.2"></ellipse>
            <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(60 12 12)"></ellipse>
            <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(120 12 12)"></ellipse>
          </svg>
          <h3 class="cap-title">Physics Domain</h3>
          <div class="cap-body">I understand the science, not just the code.</div>
          <div class="cap-tech">Particle physics · Spectroscopy · Avionics</div>
        </div>
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" aria-hidden="true" stroke-linecap="round">
            <path d="M21 4v6h-6"></path>
            <path d="M3 20v-6h6"></path>
            <path d="M3.5 9a9 9 0 0 1 14.9-3.4L21 8M3 16l2.6 2.4A9 9 0 0 0 20.5 15"></path>
          </svg>
          <h3 class="cap-title">Modernization</h3>
          <div class="cap-body">Legacy MATLAB &amp; Fortran &rarr; modern Python.</div>
          <div class="cap-tech">Tested · Typed · Documented</div>
        </div>
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" aria-hidden="true" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4" stroke-linecap="round"></path>
          </svg>
          <h3 class="cap-title">Production</h3>
          <div class="cap-body">Built to survive real environments.</div>
          <div class="cap-tech">NIST 800-53 · NASA NPR 7123</div>
        </div>
      </div>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">03</span>
      <h2 class="section-heading">Good fit for</h2>
      <ul class="fit-list">
        <li>
          Research labs or universities with prototype code that needs to scale or survive a handoff
        </li>
        <li>
          Teams stuck on legacy MATLAB or Fortran that needs modernizing without breaking the
          science
        </li>
        <li>Startups running simulations too slow to iterate on</li>
        <li>Anyone who needs a physicist who can also ship software</li>
      </ul>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">04</span>
      <h2 class="section-heading">How we'd start</h2>
      <ol class="process-list">
        <li class="process-step">
          <span class="process-num">01</span>
          <div class="process-text">
            <strong>You email me what you're stuck on.</strong>
            A slow simulation, a handoff that keeps breaking, legacy code no one wants to touch.
          </div>
        </li>
        <li class="process-step">
          <span class="process-num">02</span>
          <div class="process-text">
            <strong>A 30-minute call to see if it's a fit.</strong>
            No pitch deck - I'll tell you straight whether I'm the right person for it.
          </div>
        </li>
        <li class="process-step">
          <span class="process-num">03</span>
          <div class="process-text">
            <strong>We start with a small, scoped piece.</strong>
            Something concrete with a clear outcome, so you can judge the work before committing to more.
          </div>
        </li>
      </ol>
    </section>

    <div class="divider-line"></div>

    <section class="content-section">
      <span class="section-kicker">05</span>
      <h2 class="section-heading">Questions</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary class="faq-q">
                {f.q}
                <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <div class="divider-line"></div>

    <section class="cta-section">
      <p class="cta-note">
        Tell me what you're working on and where it's stuck. If it's a fit, we'll start small; if
        not, I'll point you the right way. Either way, I reply within a day.
      </p>
      <div class="cta-actions">
        <a href={mailto} class="cta-btn-body"
          >Start the conversation <span class="arr">&rarr;</span></a
        >
        <button
          type="button"
          class="cta-copy"
          data-email="jacobchesslo@gmail.com"
          aria-label="Copy email address jacobchesslo@gmail.com to clipboard"
        >
          <svg class="cta-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="cta-copy-label" aria-live="polite">jacobchesslo@gmail.com</span>
        </button>
      </div>
    </section>
  </article>

  <a href={mailto} class="sticky-cta" id="science-sticky">
    <span class="sticky-cta-tag">Science &amp; Engineering</span>
    <span class="sticky-cta-action">Let's talk <span class="arr">&rarr;</span></span>
  </a>
</Layout>

<script>
  const scene = document.getElementById('science-scene')! as HTMLElement;
  const canvas = document.getElementById('science-canvas')! as HTMLCanvasElement;
  const hintEl = document.getElementById('scroll-hint')! as HTMLElement;
  const progressEl = document.getElementById('science-progress')! as HTMLElement;
  const pillEl = document.querySelector('.text-pill')! as HTMLElement;
  const stickyEl = document.getElementById('science-sticky')! as HTMLElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Lorenz: dx/dt = σ(y−x), dy/dt = x(ρ−z)−y, dz/dt = xy−βz
  const SIGMA = 10,
    RHO = 28,
    BETA = 8 / 3,
    DT = 0.005;
  function lorenzStep(x: number, y: number, z: number): [number, number, number] {
    return [x + SIGMA * (y - x) * DT, y + (x * (RHO - z) - y) * DT, z + (x * y - BETA * z) * DT];
  }

  const N = 64,
    TRAIL = 90;

  interface Particle {
    rx: number;
    ry: number;
    lx: number;
    ly: number;
    lz: number;
    trail: [number, number][];
    x: number;
    y: number;
    vx: number;
    vy: number;
    hue: number;
  }

  let W = 0,
    H = 0;
  let rawProgress = 0,
    displayProgress = 0;
  let sceneOffscreen = false; // true once scrolled past the scene → throttle the backdrop
  let ctaInView = false; // true when the final CTA is on screen → hide the redundant sticky CTA
  let lastDraw = 0;
  let pts: Particle[] = [];
  let clouds: { x: number; y: number; r: number }[] = [];

  const ov1El = document.getElementById('ov1')! as HTMLElement;
  const ov2El = document.getElementById('ov2')! as HTMLElement;
  const ov3El = document.getElementById('ov3')! as HTMLElement;

  // Project Lorenz x-z plane → canvas; attractor spans x∈[-22,22], z∈[4,46]
  function project(lx: number, lz: number): [number, number] {
    const scale = Math.min(W, H) / 50;
    return [W / 2 + lx * scale, H * 0.52 - (lz - 25) * scale];
  }

  function initParticles() {
    pts = [];
    clouds = [];
    for (let i = 0; i < N; i++) {
      let lx = 0.1 + (Math.random() - 0.5) * 8;
      let ly = 0.1 + (Math.random() - 0.5) * 8;
      let lz = 20 + (Math.random() - 0.5) * 8;
      for (let w = 0; w < 2000; w++) [lx, ly, lz] = lorenzStep(lx, ly, lz);
      const stagger = Math.floor(Math.random() * 600);
      for (let s = 0; s < stagger; s++) [lx, ly, lz] = lorenzStep(lx, ly, lz);
      pts.push({
        rx: Math.random() * W,
        ry: Math.random() * H,
        lx,
        ly,
        lz,
        trail: [],
        x: 0,
        y: 0,
        vx: (Math.random() - 0.5) * 0.45,
        vy: (Math.random() - 0.5) * 0.45,
        hue: 275 + (Math.random() - 0.5) * 50,
      });
      pts[i].x = pts[i].rx;
      pts[i].y = pts[i].ry;
    }
    for (let i = 0; i < 8; i++)
      clouds.push({ x: Math.random() * W, y: Math.random() * H, r: 60 + Math.random() * 90 });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  function resize() {
    const newW = canvas.offsetWidth,
      newH = canvas.offsetHeight;
    const widthChanged = Math.abs(newW - W) > 20;
    W = newW;
    H = newH;
    if (widthChanged || pts.length === 0) {
      // Only reset canvas dimensions on a real resize - assigning these clears the canvas
      canvas.width = Math.round(W * devicePixelRatio);
      canvas.height = Math.round(H * devicePixelRatio);
      ctx.scale(devicePixelRatio, devicePixelRatio);
      initParticles();
    }
    // Height-only (iOS URL bar): update H for projection math, never touch canvas dims
  }

  function eio(t: number) {
    return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
  }
  function clamp(v: number, a: number, b: number) {
    return Math.max(a, Math.min(b, v));
  }
  function phase(p: number, start: number, len: number) {
    return clamp((p - start) / len, 0, 1);
  }
  // Trapezoidal hold: quick fade in, full opacity across the band, quick fade out
  function band(p: number, a: number, b: number, f = 0.04) {
    return clamp((p - a) / f, 0, 1) * clamp((b - p) / f, 0, 1);
  }

  function draw(_ts: number) {
    ctx.clearRect(0, 0, W, H);
    displayProgress += (rawProgress - displayProgress) * (reduced ? 1 : 0.09);
    const prog = reduced ? 1 : displayProgress; // smoothed: drives the animation morph
    const ui = reduced ? 0 : rawProgress; // raw scroll drives captions + chrome; the tall scene gives each beat its dwell distance

    const lorenz = eio(phase(prog, 0.12, 0.48)); // scatter → attractor, done ~0.60

    // Scatter blobs fade as attractor forms
    const cloudA = clamp(1 - lorenz * 2.5, 0, 1);
    if (cloudA > 0.01) {
      for (const cl of clouds) {
        const g = ctx.createRadialGradient(cl.x, cl.y, 0, cl.x, cl.y, cl.r);
        g.addColorStop(0, `oklch(58% 0.22 295 / ${cloudA * 0.17})`);
        g.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(cl.x, cl.y, cl.r, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
      }
    }

    // Step Lorenz + lerp positions from scatter → attractor
    for (const p of pts) {
      [p.lx, p.ly, p.lz] = lorenzStep(p.lx, p.ly, p.lz);
      const [px, py] = project(p.lx, p.lz);
      if (lorenz < 1) {
        p.rx += p.vx * (1 - lorenz) * 0.5;
        p.ry += p.vy * (1 - lorenz) * 0.5;
        if (p.rx < 0 || p.rx > W) p.vx *= -1;
        if (p.ry < 0 || p.ry > H) p.vy *= -1;
      }
      p.x = p.rx + (px - p.rx) * lorenz;
      p.y = p.ry + (py - p.ry) * lorenz;
      if (lorenz > 0.2) {
        p.trail.push([p.x, p.y]);
        if (p.trail.length > TRAIL) p.trail.shift();
      } else {
        p.trail = [];
      }
    }

    // Trails
    const trailA = clamp((lorenz - 0.2) / 0.5, 0, 1);
    if (trailA > 0) {
      for (const p of pts) {
        if (p.trail.length < 3) continue;
        ctx.beginPath();
        ctx.moveTo(p.trail[0][0], p.trail[0][1]);
        for (let i = 1; i < p.trail.length; i++) ctx.lineTo(p.trail[i][0], p.trail[i][1]);
        ctx.strokeStyle = `oklch(66% 0.22 ${p.hue} / ${trailA * 0.5})`;
        ctx.lineWidth = 0.9;
        ctx.stroke();
      }
    }

    // Particles (glow so the scene reads as the hero, not a void)
    ctx.shadowBlur = 8;
    for (const p of pts) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.9, 0, Math.PI * 2);
      ctx.shadowColor = `oklch(72% 0.2 ${p.hue})`;
      ctx.fillStyle = `oklch(74% 0.2 ${p.hue} / ${0.5 + lorenz * 0.4})`;
      ctx.fill();
    }
    ctx.shadowBlur = 0;

    // Beat captions: solid holds, back-to-back so the story never stalls or ghosts
    ov1El.style.opacity = String(band(ui, 0.12, 0.36));
    ov2El.style.opacity = String(band(ui, 0.4, 0.64));
    ov3El.style.opacity = String(band(ui, 0.68, 0.99));

    // Cover fades into the beat captions; sticky CTA carries conversion once we're past it
    pillEl.classList.toggle('compact', ui > 0.07);
    stickyEl.classList.toggle('visible', ui > 0.12 && !ctaInView);
    const hintOpacity = clamp((0.9 - ui) / 0.1, 0, 1); // persist the "keep scrolling" chevron through the scene, fade as the proof nears
    hintEl.style.opacity = String(hintOpacity);
    hintEl.style.visibility = hintOpacity < 0.05 ? 'hidden' : 'visible'; // drop from tab order when faded
    progressEl.style.transform = `scaleX(${ui})`;
  }

  function updateProgress() {
    const rect = scene.getBoundingClientRect();
    const scrollable = scene.offsetHeight - window.innerHeight;
    if (scrollable > 0) rawProgress = Math.max(0, Math.min(1, -rect.top / scrollable));
    // Once we're past the scene into the body, fade the canvas to a faint backdrop
    const past = -rect.top - scrollable;
    const fade = clamp(past / (window.innerHeight * 0.6), 0, 1);
    canvas.style.opacity = String(1 - fade * 0.88);
    sceneOffscreen = past > window.innerHeight * 0.6; // fully faded → no longer the focus
  }

  resize();
  updateProgress();
  window.addEventListener(
    'resize',
    () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    },
    { passive: true }
  );
  window.addEventListener('scroll', updateProgress, { passive: true });

  // Gentle scroll-reveal for the body sections (added in JS so no-JS still shows everything)
  if (!reduced) {
    const revealEls = document.querySelectorAll<HTMLElement>(
      '.proof-band, .consult-body .content-section, .cta-section'
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    revealEls.forEach((el) => {
      el.classList.add('reveal');
      io.observe(el);
    });
  }

  // Hide the sticky CTA once the real CTA section is on screen (avoid redundant CTAs at conversion)
  const ctaSection = document.querySelector('.cta-section');
  if (ctaSection) {
    new IntersectionObserver(
      ([entry]) => {
        ctaInView = entry.isIntersecting;
      },
      { rootMargin: '0px 0px -10% 0px' }
    ).observe(ctaSection);
  }

  // Count the proof metrics up from zero the first time they enter view
  if (!reduced) {
    const nums = document.querySelectorAll<HTMLElement>('.proof-num[data-to]');
    const fmt = (v: number, dec: number, suffix: string) => v.toFixed(dec) + suffix;
    nums.forEach((el) => {
      el.textContent = fmt(0, Number(el.dataset.dec || 0), el.dataset.suffix || '');
    });
    const countUp = (el: HTMLElement) => {
      const to = Number(el.dataset.to);
      const dec = Number(el.dataset.dec || 0);
      const suffix = el.dataset.suffix || '';
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / 1100);
        const e = 1 - Math.pow(1 - t, 3); // easeOutCubic
        el.textContent = fmt(to * e, dec, suffix);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const band = document.querySelector('.proof-band');
    if (band) {
      const co = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            nums.forEach(countUp);
            co.disconnect();
          }
        },
        { rootMargin: '0px 0px -20% 0px' }
      );
      co.observe(band);
    }
    // On print/PDF the count-up may be mid-animation - force final values so a
    // saved PDF never shows weaker, wrong proof numbers.
    window.addEventListener('beforeprint', () => {
      nums.forEach((el) => {
        el.textContent = fmt(
          Number(el.dataset.to),
          Number(el.dataset.dec || 0),
          el.dataset.suffix || ''
        );
      });
    });
  }

  // Copy-email fallback so the address is capturable even when mailto does nothing
  const copyBtn = document.querySelector<HTMLButtonElement>('.cta-copy');
  if (copyBtn) {
    const label = copyBtn.querySelector<HTMLElement>('.cta-copy-label')!;
    const original = label.textContent;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email || '');
      } catch {
        // Clipboard blocked (insecure context / old browser) - select the address for manual copy
        const sel = window.getSelection();
        if (sel) {
          const range = document.createRange();
          range.selectNodeContents(label);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        return;
      }
      copyBtn.classList.add('copied');
      label.textContent = 'Copied to clipboard ✓';
      window.setTimeout(() => {
        copyBtn.classList.remove('copied');
        label.textContent = original;
      }, 1800);
    });
  }

  // Snappier "skip" than the native 1.2s smooth-scroll over the long scene (eased ~0.65s)
  const skipCue = document.getElementById('scroll-hint');
  const proof = document.getElementById('science-proof');
  if (skipCue && proof && !reduced) {
    skipCue.addEventListener('click', (e) => {
      e.preventDefault();
      const startY = window.scrollY;
      const dist = proof.offsetTop - 84 - startY;
      const t0 = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / 650);
        // behavior:'instant' so our easing drives it, not the global scroll-behavior:smooth
        window.scrollTo({ top: startY + dist * ease(t), behavior: 'instant' });
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  if (reduced) {
    rawProgress = 1;
    draw(0);
  } else {
    function tick(ts: number) {
      // Skip all physics/drawing while the tab is hidden - nobody's watching, save the battery
      if (document.hidden) {
        requestAnimationFrame(tick);
        return;
      }
      // Full 60fps while the scene is the focus; throttle to ~12fps once it's a faint backdrop
      if (!sceneOffscreen || ts - lastDraw > 80) {
        draw(ts);
        lastDraw = ts;
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>


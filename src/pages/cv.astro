---
import Layout from '../layouts/Layout.astro';
import { marked, type Token, type Tokens } from 'marked';
import { PERSON_BASE } from '../components/constants';
import cvRaw from '../content/curriculum-vitae/README.md?raw';

const renderer = new marked.Renderer();

let currentSection = '';
let isContactParagraph = false;

renderer.heading = function ({ text, depth }) {
  if (depth === 1) {
    isContactParagraph = true;
    return `<h1 class="cv-name">${text}</h1>\n`;
  }
  if (depth === 2) {
    currentSection = text;
    isContactParagraph = false;
    return `<h2 class="cv-section-label">${text}</h2>\n`;
  }
  if (depth === 3) return `<h3 class="cv-entry-title">${text}</h3>\n`;
  return `<h${depth}>${text}</h${depth}>\n`;
};

renderer.paragraph = function ({ tokens }) {
  const rendered = this.parser.parseInline(tokens);
  if (isContactParagraph) {
    isContactParagraph = false;
    const items = rendered.split('\n').filter(Boolean);
    const inner = items.map((s) => `<span class="cv-contact-item">${s}</span>`).join('');
    return `<div class="cv-contact-block">${inner}</div>\n`;
  }
  return `<p class="cv-p">${rendered}</p>\n`;
};

renderer.link = function ({ href, title, text }) {
  const isExternal = href && (href.startsWith('http') || href.startsWith('//'));
  const attrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
  const titleAttr = title ? ` title="${title}"` : '';
  return `<a href="${href}"${titleAttr}${attrs}>${text}</a>`;
};

renderer.list = function ({ items, ordered }) {
  if (currentSection === 'Professional and Research Interests') {
    const chips = items
      .map((item) => `<span class="cv-interest-chip">${item.text}</span>`)
      .join('');
    return `<div class="cv-interests">${chips}</div>\n`;
  }

  const tag = ordered ? 'ol' : 'ul';
  const inner = items
    .map((item) => {
      const nestedLists = item.tokens
        .filter((t: Token): t is Tokens.List => t.type === 'list')
        .map((t: Tokens.List) => renderer.list(t))
        .join('');
      const textToken = item.tokens.find(
        (t: Token): t is Tokens.Text | Tokens.Paragraph =>
          t.type === 'text' || t.type === 'paragraph'
      );
      const body = textToken ? (marked.parseInline(textToken.text) as string) : item.text;
      return `<li>${body}${nestedLists}</li>`;
    })
    .join('\n');
  return `<${tag} class="cv-list">\n${inner}\n</${tag}>\n`;
};

marked.use({ renderer, async: false });
const cvHtml = marked.parse(cvRaw) as string;

const now = new Date();
const month = now.toLocaleString('en-US', { month: 'short' });
const day = String(now.getDate()).padStart(2, '0');
const year = now.getFullYear();
const cvFilename = `JacobChessloCV-${month}-${day}-${year}.pdf`;

// The CV is the canonical résumé - the richest Person-entity page on the site
const personSchema = { ...PERSON_BASE, url: Astro.url.origin + '/' };
---

<Layout
  title="CV | Jacob Chesslo"
  description="Curriculum vitae of Jacob Chesslo - software engineer at Blue Origin and physicist. Background spans particle physics at CERN, HPC, and aerospace avionics."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <div class="cv-page">
    <div class="cv-download-bar">
      <a href="/JacobChessloCV.pdf" download={cvFilename} class="btn btn-primary cv-download">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download PDF
      </a>
    </div>

    <div class="cv-md-body" set:html={cvHtml} />
  </div>
</Layout>

<style>
  .cv-page {
    padding: 120px var(--space-lg) var(--space-2xl);
    max-width: 960px;
    margin: 0 auto;
  }

  .cv-download-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-lg);
  }

  /* ── Markdown body ─────────────────────────────────────── */

  .cv-md-body :global(.cv-name) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    margin-bottom: 16px;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  /* Contact block */
  .cv-md-body :global(.cv-contact-block) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .cv-md-body :global(.cv-contact-item) {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .cv-md-body :global(.cv-section-label) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 400;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .cv-md-body :global(.cv-entry-title) {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    margin-top: var(--space-md);
    margin-bottom: 2px;
  }

  /* Date / org line */
  .cv-md-body :global(.cv-entry-title + .cv-p) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--tertiary);
    margin-bottom: 3px;
  }

  .cv-md-body :global(.cv-p) {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 5px;
  }

  /* Interests chips */
  .cv-md-body :global(.cv-interests) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-md);
  }

  .cv-md-body :global(.cv-interest-chip) {
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-dim);
    background: var(--surface);
    line-height: 1.4;
  }

  .cv-md-body :global(.cv-list) {
    margin: 6px 0 14px 22px;
    padding: 0;
  }

  .cv-md-body :global(.cv-list li) {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--text-dim);
    line-height: 1.65;
    margin-bottom: 3px;
  }

  .cv-md-body :global(.cv-list .cv-list) {
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .cv-md-body :global(a) {
    color: var(--accent);
    /* Underlined at rest (not just on hover) so links are distinguishable without color alone -
       WCAG 1.4.1. Subtle offset/color keeps it elegant in the dense résumé. */
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 45%, transparent);
    text-underline-offset: 2px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .cv-md-body :global(a:hover) {
    color: var(--secondary);
    text-decoration-color: var(--secondary);
  }

  /* Long reference URLs in presentations/posters */
  .cv-md-body :global(.cv-list li a[href^='http']) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    word-break: break-all;
    color: var(--text-muted);
  }
  .cv-md-body :global(.cv-list li a[href^='http']:hover) {
    color: var(--accent);
  }

  .cv-md-body :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .cv-md-body :global(em) {
    font-style: italic;
    color: var(--secondary);
  }

  .cv-md-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-lg) 0;
  }

  /* Responsive */
  @media (max-width: 700px) {
    .cv-page {
      padding: 100px var(--space-md) var(--space-xl);
    }
  }

  /* ── Print ─────────────────────────────────────────────── */
  @media print {
    :root {
      --bg: #ffffff;
      --surface: #ffffff;
      --border: #d0d0d0;
      --text: #111111;
      --text-dim: #444444;
      --text-muted: #888888;
      --accent: #1a1a1a;
      --secondary: #1a1a1a;
      --tertiary: #555555;
    }

    body::before {
      display: none;
    }
    nav,
    .site-footer,
    .nav-mobile {
      display: none !important;
    }
    .cv-download-bar {
      display: none !important;
    }

    body {
      background: #fff;
      color: #111;
    }

    .cv-page {
      padding: 0;
      max-width: 100%;
    }

    .cv-md-body :global(.cv-section-label) {
      color: #000;
      border-bottom-color: #bbb;
    }
    .cv-md-body :global(a) {
      color: #333;
    }
    .cv-md-body :global(em) {
      color: #333;
    }
    .cv-md-body :global(strong) {
      color: #000;
    }

    @page {
      margin: 0.6in 0.65in;
      size: letter portrait;
    }
  }
</style>

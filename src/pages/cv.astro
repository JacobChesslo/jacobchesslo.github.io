---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import cvRaw from '../content/curriculum-vitae/README.md?raw';

const renderer = new marked.Renderer();

// h1 → big name
renderer.heading = function ({ text, depth }) {
  if (depth === 1) return `<h1 class="cv-name">${text}</h1>\n`;
  if (depth === 2) return `<h2 class="cv-section-label">${text}</h2>\n`;
  if (depth === 3) return `<h3 class="cv-entry-title">${text}</h3>\n`;
  return `<h${depth}>${text}</h${depth}>\n`;
};

renderer.paragraph = function ({ text }) {
  return `<p class="cv-p">${text}</p>\n`;
};

renderer.list = function ({ items, ordered }) {
  const tag = ordered ? 'ol' : 'ul';
  const inner = items
    .map((item) => {
      const body = item.tokens.map((t) => (t.type === 'text' ? t.text : '')).join('') || item.text;
      return `<li>${body}</li>`;
    })
    .join('\n');
  return `<${tag} class="cv-list">\n${inner}\n</${tag}>\n`;
};

marked.use({ renderer, async: false });
const cvHtml = marked.parse(cvRaw) as string;

const now = new Date();
const month = now.toLocaleString('en-US', { month: 'short' });
const day = String(now.getDate()).padStart(2, '0');
const year = now.getFullYear();
const cvFilename = `JacobChessloCV-${month}-${day}-${year}.pdf`;
---

<Layout
  title="CV | Jacob Chesslo"
  description="Curriculum vitae of Jacob Chesslo - software engineer, physicist, and researcher."
>
  <div class="cv-page">
    <div class="cv-download-bar">
      <a href="/JacobChessloCV.pdf" download={cvFilename} class="btn btn-primary cv-download">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download PDF
      </a>
    </div>

    <div class="cv-md-body" set:html={cvHtml} />
  </div>
</Layout>

<style>
  .cv-page {
    padding: 120px var(--space-lg) var(--space-2xl);
    max-width: 960px;
    margin: 0 auto;
  }

  .cv-download-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-lg);
  }

  /* ── Markdown body ─────────────────────────────────────── */

  .cv-md-body :global(.cv-name) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    margin-bottom: 12px;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  /* Contact block - first .cv-p after .cv-name */
  .cv-md-body :global(.cv-name + .cv-p) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    line-height: 2;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .cv-md-body :global(.cv-section-label) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 400;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .cv-md-body :global(.cv-entry-title) {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    margin-top: var(--space-md);
    margin-bottom: 2px;
  }

  /* Date / org line - first .cv-p after an entry title */
  .cv-md-body :global(.cv-entry-title + .cv-p) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--tertiary);
    margin-bottom: 3px;
  }

  .cv-md-body :global(.cv-p) {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 5px;
  }

  .cv-md-body :global(.cv-list) {
    margin: 6px 0 14px 22px;
    padding: 0;
  }

  .cv-md-body :global(.cv-list li) {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--text-dim);
    line-height: 1.65;
    margin-bottom: 3px;
  }

  .cv-md-body :global(.cv-list .cv-list) {
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .cv-md-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
    word-break: break-all;
  }
  .cv-md-body :global(a:hover) {
    color: var(--secondary);
  }

  .cv-md-body :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .cv-md-body :global(em) {
    font-style: italic;
    color: var(--secondary);
  }

  .cv-md-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-lg) 0;
  }

  /* Responsive */
  @media (max-width: 700px) {
    .cv-page {
      padding: 100px var(--space-md) var(--space-xl);
    }
  }

  /* ── Print ─────────────────────────────────────────────── */
  @media print {
    :root {
      --bg: #ffffff;
      --surface: #ffffff;
      --border: #d0d0d0;
      --text: #111111;
      --text-dim: #444444;
      --text-muted: #888888;
      --accent: #1a1a1a;
      --secondary: #1a1a1a;
      --tertiary: #555555;
    }

    body::before {
      display: none;
    }
    nav,
    .site-footer,
    .nav-mobile {
      display: none !important;
    }
    .cv-download-bar {
      display: none !important;
    }

    body {
      background: #fff;
      color: #111;
    }

    .cv-page {
      padding: 0;
      max-width: 100%;
    }

    .cv-md-body :global(.cv-section-label) {
      color: #000;
      border-bottom-color: #bbb;
    }
    .cv-md-body :global(a) {
      color: #333;
    }
    .cv-md-body :global(em) {
      color: #333;
    }
    .cv-md-body :global(strong) {
      color: #000;
    }

    @page {
      margin: 0.6in 0.65in;
      size: letter portrait;
    }
  }
</style>

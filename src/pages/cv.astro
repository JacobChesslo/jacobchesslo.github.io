---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

// Read the CV markdown file
const cvPath = path.join(process.cwd(), 'src/content/cv.md');
const cvContent = fs.readFileSync(cvPath, 'utf-8');
const cvHtml = await marked(cvContent);
---

<Layout>
  <main class="py-12">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl md:text-5xl font-bold text-[#fef5e7] mb-4" style="font-family: 'Space Grotesk', sans-serif; text-shadow: 3px 3px 0 #e94560;">
        Curriculum Vitae
      </h1>
      <div class="w-24 h-1 mx-auto bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e] rounded-full mb-6"></div>

      <!-- Download Button - links to pre-built PDF -->
      <a
        href="/JacobChessloCV.pdf"
        download="JacobChessloCV.pdf"
        class="retro-btn inline-flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download PDF
      </a>
    </div>

    <!-- CV Content -->
    <article id="cv-content" class="cv-article retro-card max-w-4xl mx-auto">
      <Fragment set:html={cvHtml} />
    </article>

    <!-- Decorative bottom element -->
    <div class="flex justify-center items-center gap-4 mt-12">
      <span class="text-[#e94560]">*</span>
      <div class="w-2 h-2 rounded-full bg-[#f8b500]"></div>
      <span class="text-[#0f9b8e]">*</span>
    </div>
  </main>
</Layout>

<style>
  .cv-article {
    font-family: 'Outfit', sans-serif;
    line-height: 1.7;
  }

  .cv-article :global(h1) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #e94560;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 0 rgba(233, 69, 96, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cv-article :global(h2) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #f8b500;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #f8b500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cv-article :global(h3) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #0f9b8e;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .cv-article :global(p) {
    color: #fef5e7;
    margin-bottom: 0.75rem;
  }

  .cv-article :global(ul) {
    list-style: none;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .cv-article :global(li) {
    color: rgba(254, 245, 231, 0.9);
    margin-bottom: 0.5rem;
    position: relative;
  }

  .cv-article :global(li::before) {
    content: "*";
    position: absolute;
    left: -1.25rem;
    color: #e94560;
    font-weight: bold;
  }

  .cv-article :global(a) {
    color: #0f9b8e;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .cv-article :global(a:hover) {
    color: #f8b500;
  }

  .cv-article :global(strong) {
    color: #fef5e7;
    font-weight: 600;
  }

  .cv-article :global(em) {
    color: rgba(254, 245, 231, 0.8);
    font-style: italic;
  }

  /* Print-friendly styles for PDF */
  @media print {
    .cv-article {
      background: white !important;
      color: black !important;
      padding: 0 !important;
      border: none !important;
    }

    .cv-article :global(h1),
    .cv-article :global(h2),
    .cv-article :global(h3) {
      color: black !important;
      text-shadow: none !important;
    }

    .cv-article :global(p),
    .cv-article :global(li) {
      color: black !important;
    }

    .cv-article :global(a) {
      color: #0066cc !important;
    }
  }
</style>

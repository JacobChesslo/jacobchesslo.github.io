---
import Layout from '../layouts/Layout.astro';

import { GITHUB_URL } from '../components/constants';
import ExternalLink from '../components/ExternalLink';

import ProjectCard from '../components/ProjectCard';
---

<Layout>
  <main class="py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1
        class="text-4xl md:text-5xl font-bold text-[#fef5e7] mb-4"
        style="font-family: 'Space Grotesk', sans-serif; text-shadow: 3px 3px 0 #e94560;"
      >
        My Projects
      </h1>
      <div
        class="w-24 h-1 mx-auto bg-gradient-to-r from-[#e94560] via-[#f8b500] to-[#0f9b8e] rounded-full"
      >
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            name: 'jacobchesslo.github.io',
            children: (
              <>
                A personal website. Built with
                <ExternalLink href="https://astro.build">Astro</ExternalLink>,
                <ExternalLink href="https://www.solidjs.com">SolidJS</ExternalLink>,
                <ExternalLink href="https://tailwindcss.com">TailwindCSS</ExternalLink>, and
                <ExternalLink href="https://vite.dev">Vite</ExternalLink>.
              </>
            ),
          },
        ].map((item) => (
          <ProjectCard name={item.name} href={`${GITHUB_URL}/${item?.name}`}>
            {item.children}
          </ProjectCard>
        ))
      }
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Jacob Chesslo" description="Get in touch with Jacob Chesslo.">
  <main class="contact-main">
    <div class="contact-header">
      <h1 class="contact-title">Contact</h1>
      <div class="contact-rule" aria-hidden="true"></div>
    </div>

    <div class="contact-card-wrap">
      <div class="retro-card contact-card">
        <p class="contact-body">Want to get in touch? I&rsquo;d love to hear from you.</p>
        <a href="mailto:jacobchesslo@gmail.com" class="retro-btn">Send Email</a>
        <p class="contact-email">jacobchesslo@gmail.com</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Hallmark · macrostructure: Long Document · tone: atmospheric · anchor hue: violet */

  .contact-main {
    padding: 3rem 0 6rem;
  }

  .contact-header {
    margin-bottom: 3rem;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .contact-rule {
    width: 6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright), var(--secondary));
  }

  .contact-card-wrap {
    max-width: 28rem;
  }

  .contact-card {
    text-align: center;
  }

  .contact-body {
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
  }

  .contact-email {
    margin-top: 1rem;
    color: var(--accent-bright);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }
</style>
